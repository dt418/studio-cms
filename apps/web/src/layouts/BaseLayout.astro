---
import '../styles/app.css'
import { SITE } from '@/lib/site'
import { resolveOgImage } from '@/lib/og-image'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { getTranslations } from '@/lib/i18n'
import { getWebMCPTools } from '@/lib/agent-metadata'
import type { SupportedLocale } from '@/lib/content-utils'

export interface Props {
  title: string
  description?: string
  image?: string
  canonicalUrl?: string
  publishedTime?: string
  modifiedTime?: string
  author?: string
  type?: 'website' | 'article'
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  lang?: SupportedLocale
  currentPath?: string
  alternateUrls?: Record<SupportedLocale, string>
}

const {
  title,
  description = SITE.description,
  image,
  canonicalUrl,
  publishedTime,
  modifiedTime,
  author = SITE.author,
  type = 'website',
  noindex = false,
  jsonLd,
  lang = 'vi',
  currentPath = Astro.url.pathname,
  alternateUrls,
} = Astro.props

const siteUrl = (Astro.site ?? Astro.url).origin || 'http://localhost:4321'
const defaultImage = `${siteUrl}/og-image.png`
const ogImageUrl = resolveOgImage(image, siteUrl, defaultImage)
const ogImageType = ogImageUrl.endsWith('.webp') ? 'image/webp' : 'image/png'

const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`
const i18n = getTranslations(lang)

const isHomepage = currentPath === `/${lang}/` || currentPath === `/${lang}`
const isBlogActive = isHomepage || currentPath.includes(`/${lang}/blog`)
const isAboutActive = currentPath.includes(`/${lang}/about`)

const webMCPTools = getWebMCPTools()
const webMCPPayload = JSON.stringify({ tools: webMCPTools })
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={i18n.rss.title} href="/rss.xml" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <script is:inline>
      try {
        const config = JSON.parse(localStorage.getItem('theme-config') ?? 'null')
        const root = document.documentElement
        if (config?.theme === 'light') {
          root.classList.remove('dark')
        } else {
          root.classList.add('dark')
        }
      } catch {
        document.documentElement.classList.add('dark')
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    {
      alternateUrls &&
        Object.entries(alternateUrls).map(([locale, url]) => (
          <link rel="alternate" hreflang={locale} href={url} />
        ))
    }
    {alternateUrls && <link rel="alternate" hreflang="x-default" href={alternateUrls['vi']} />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'vi_VN'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.social.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {author && <meta name="twitter:creator" content={SITE.social.twitter} />}

    {author && <meta name="author" content={author} />}

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script id="webmcp-context" type="application/json" set:html={webMCPPayload} is:inline />
    <script is:inline>
      ;(function () {
        try {
          const node = document.getElementById('webmcp-context')
          if (
            !node ||
            !navigator.modelContext ||
            typeof navigator.modelContext.provideContext !== 'function'
          )
            return
          const raw = node.textContent || '{}'
          const payload = JSON.parse(raw)
          if (!payload || !Array.isArray(payload.tools)) return
          const tools = payload.tools.map(function (tool) {
            return {
              name: tool.name,
              description: tool.description,
              inputSchema: tool.inputSchema,
              handler: function () {
                return Promise.resolve({
                  content: [
                    {
                      type: 'text',
                      text:
                        'Visit ' +
                        window.location.origin +
                        '/api/posts.json for live blog data, or /auth.md for the auth policy.',
                    },
                  ],
                })
              },
            }
          })
          navigator.modelContext.provideContext({ tools: tools })
        } catch {
          return undefined
        }
      })()
    </script>
  </head>
  <body
    class="bg-background text-foreground overflow-x-hidden antialiased"
    style="font-family: var(--font-sans);"
  >
    <a
      href="#main-content"
      class="focus:bg-muted focus:text-primary focus:ring-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:ring-2 focus:outline-none"
    >
      {i18n.nav.skipToContent}
    </a>

    <header
      class="nav border-border sticky top-0 z-50 flex items-center justify-between border-b bg-[rgba(10,10,10,0.92)] px-8 py-6 backdrop-blur-[20px] lg:px-12"
    >
      <a
        href={`/${lang}`}
        class="nav-logo font-display text-foreground hover:text-primary text-[1.5rem] font-bold tracking-[-0.03em] transition-colors"
        aria-label={i18n.nav.brandHome}
      >
        DT<span class="text-primary">.</span>
      </a>
      <nav class="nav-links flex items-center gap-8">
        <a
          href={`/${lang}/blog`}
          class:list={[
            'nav-link font-mono text-[0.7rem] tracking-[0.1em] uppercase transition-colors',
            isBlogActive
              ? 'text-foreground border-foreground border-b pb-0.5'
              : 'text-muted-foreground hover:text-primary',
          ]}
        >
          {i18n.nav.writing}
        </a>
        <a
          href={`/${lang}/about`}
          class:list={[
            'nav-link font-mono text-[0.7rem] tracking-[0.1em] uppercase transition-colors',
            isAboutActive
              ? 'text-foreground border-foreground border-b pb-0.5'
              : 'text-muted-foreground hover:text-primary',
          ]}
        >
          {i18n.nav.about}
        </a>
        <a
          href="/rss.xml"
          class="nav-badge bg-border text-muted-foreground hover:text-primary rounded-full px-3 py-1.5 font-mono text-[0.65rem] tracking-[0.08em] transition-colors"
        >
          RSS
        </a>
        <LanguageSwitcher
          currentLang={lang}
          currentPath={currentPath}
          label={i18n.language.navigation}
          languageNames={i18n.language.names}
          getSwitchLabel={i18n.language.switchTo}
        />
      </nav>
    </header>

    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <footer class="border-border flex items-center justify-between border-t px-8 py-6 lg:px-12">
      <span class="text-muted-foreground font-mono text-[0.65rem] tracking-[0.08em]">
        DanhThanh.dev © {new Date().getFullYear()}
      </span>
      <div class="flex items-center gap-6">
        <LanguageSwitcher
          currentLang={lang}
          currentPath={currentPath}
          label={i18n.language.footerNavigation}
          languageNames={i18n.language.names}
          getSwitchLabel={i18n.language.switchTo}
        />
      </div>
    </footer>
  </body>
</html>
