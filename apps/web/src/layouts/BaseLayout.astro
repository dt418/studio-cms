---
import '../styles/app.css'
import { SITE } from '@/lib/site'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { getTranslations } from '@/lib/i18n'
import { getWebMCPTools } from '@/lib/agent-metadata'
import { serializeJsonLd, type SeoDocument } from '@/lib/seo'
import type { SupportedLocale } from '@/lib/content-utils'
import Icon from '@/components/Icon.astro'

export interface Props {
  seo: SeoDocument
  currentPath?: string
  alternatePaths?: Partial<Record<SupportedLocale, string>>
}

const { seo, currentPath = Astro.url.pathname, alternatePaths } = Astro.props

const { title, description, canonical, author, openGraph } = seo
const lang: SupportedLocale = seo.lang
const i18n = getTranslations(lang)

const isHomepage = currentPath === `/${lang}/` || currentPath === `/${lang}`
const isBlogActive = isHomepage || currentPath.includes(`/${lang}/blog`)
const isAboutActive = currentPath.includes(`/${lang}/about`)

const webMCPTools = getWebMCPTools()
const webMCPPayload = JSON.stringify({ tools: webMCPTools })
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={i18n.rss.title} href="/rss.xml" />
    <meta name="theme-color" content="rgb(14 13 12)" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="rgb(246 245 241)" media="(prefers-color-scheme: light)" />

    <script is:inline>
      try {
        const config = JSON.parse(localStorage.getItem('theme-config') ?? 'null')
        const root = document.documentElement
        if (config?.theme === 'light') {
          root.classList.remove('dark')
        } else {
          root.classList.add('dark')
        }
      } catch {
        document.documentElement.classList.add('dark')
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={seo.robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      seo.alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
      ))
    }
    {
      seo.defaultAlternate && (
        <link rel="alternate" hreflang="x-default" href={seo.defaultAlternate} />
      )
    }

    {openGraph && <meta property="og:title" content={title} />}
    {openGraph && <meta property="og:description" content={description} />}
    {openGraph && <meta property="og:type" content={openGraph.type} />}
    {openGraph && <meta property="og:url" content={openGraph.url} />}
    {openGraph && <meta property="og:image" content={openGraph.image.url} />}
    {openGraph && <meta property="og:image:width" content={String(openGraph.image.width)} />}
    {openGraph && <meta property="og:image:height" content={String(openGraph.image.height)} />}
    {openGraph && <meta property="og:image:type" content={openGraph.image.type} />}
    {openGraph && <meta property="og:site_name" content={SITE.name} />}
    {openGraph && <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'vi_VN'} />}
    {
      openGraph?.publishedTime && (
        <meta property="article:published_time" content={openGraph.publishedTime} />
      )
    }
    {
      openGraph?.modifiedTime && (
        <meta property="article:modified_time" content={openGraph.modifiedTime} />
      )
    }
    {openGraph?.type === 'article' && author && <meta property="article:author" content={author} />}

    {openGraph && <meta name="twitter:card" content="summary_large_image" />}
    {openGraph && <meta name="twitter:site" content={SITE.social.twitter} />}
    {openGraph && <meta name="twitter:title" content={title} />}
    {openGraph && <meta name="twitter:description" content={description} />}
    {openGraph && <meta name="twitter:image" content={openGraph.image.url} />}
    {
      openGraph?.type === 'article' && author && (
        <meta name="twitter:creator" content={SITE.social.twitter} />
      )
    }

    {openGraph?.type === 'article' && author && <meta name="author" content={author} />}

    {
      seo.jsonLd.length > 0 && (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(seo.jsonLd)} />
      )
    }

    <script id="webmcp-context" type="application/json" set:html={webMCPPayload} is:inline />
    <script is:inline>
      ;(function () {
        try {
          const node = document.getElementById('webmcp-context')
          if (
            !node ||
            !navigator.modelContext ||
            typeof navigator.modelContext.provideContext !== 'function'
          )
            return
          const raw = node.textContent || '{}'
          const payload = JSON.parse(raw)
          if (!payload || !Array.isArray(payload.tools)) return
          const tools = payload.tools.map(function (tool) {
            return {
              name: tool.name,
              description: tool.description,
              inputSchema: tool.inputSchema,
              handler: function () {
                return Promise.resolve({
                  content: [
                    {
                      type: 'text',
                      text:
                        'Visit ' +
                        window.location.origin +
                        '/api/posts.json for live blog data, or /auth.md for the auth policy.',
                    },
                  ],
                })
              },
            }
          })
          navigator.modelContext.provideContext({ tools: tools })
        } catch {
          return undefined
        }
      })()
    </script>
    <script is:inline>
      ;(function () {
        function setTheme(theme) {
          const root = document.documentElement
          root.classList.toggle('dark', theme === 'dark')
          localStorage.setItem('theme-config', JSON.stringify({ theme }))
          document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
            button.setAttribute('aria-pressed', String(theme === 'dark'))
            const label =
              theme === 'dark'
                ? button.getAttribute('data-theme-light-label')
                : button.getAttribute('data-theme-dark-label')
            if (label) button.setAttribute('title', label)
          })
          document.querySelectorAll('[data-theme-icon]').forEach(function (icon) {
            icon.classList.toggle(
              'hidden',
              icon.getAttribute('data-theme-icon') !== (theme === 'dark' ? 'light' : 'dark')
            )
          })
        }

        document.addEventListener('click', function (event) {
          const target = event.target
          if (!(target instanceof Element)) return
          const button = target.closest('[data-theme-toggle]')
          if (!button) return
          setTheme(document.documentElement.classList.contains('dark') ? 'light' : 'dark')
        })

        function syncThemeControls() {
          setTheme(document.documentElement.classList.contains('dark') ? 'dark' : 'light')
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncThemeControls, { once: true })
        } else {
          syncThemeControls()
        }

        document.addEventListener('astro:page-load', syncThemeControls)
      })()
    </script>
  </head>
  <body
    class="bg-background text-foreground flex min-h-screen flex-col overflow-x-hidden antialiased"
    style="font-family: var(--font-sans);"
  >
    <a
      href="#main-content"
      class="focus:bg-muted focus:text-primary focus:ring-primary sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:ring-2 focus:outline-none"
    >
      {i18n.nav.skipToContent}
    </a>

    <header class="border-border bg-background/90 sticky top-0 z-50 border-b backdrop-blur-xl">
      <div class="container flex h-16 items-center justify-between gap-4">
        <a
          href={`/${lang}`}
          class="group flex items-center gap-2.5"
          aria-label={i18n.nav.brandHome}
        >
          <span
            class="bg-foreground text-background group-hover:bg-primary flex h-8 w-8 items-center justify-center rounded font-mono text-xs font-bold transition-colors"
          >
            DT
          </span>
          <span class="font-display text-foreground text-lg font-bold tracking-tight">
            DanhThanh<span class="text-primary">.dev</span>
          </span>
        </a>

        <nav class="nav-links hidden items-center gap-8 md:flex" aria-label={i18n.nav.primary}>
          <a
            href={`/${lang}`}
            class:list={[
              'nav-link inline-flex items-center gap-1.5 font-mono text-[0.68rem] tracking-[0.16em] uppercase transition-colors',
              isHomepage
                ? 'text-primary border-primary border-b pb-1'
                : 'text-muted-foreground hover:text-primary',
            ]}
          >
            <Icon name="house" size={13} strokeWidth={1.75} />
            {i18n.schema.home}
          </a>
          <a
            href={`/${lang}/blog`}
            class:list={[
              'nav-link inline-flex items-center gap-1.5 font-mono text-[0.68rem] tracking-[0.16em] uppercase transition-colors',
              isBlogActive && !isHomepage
                ? 'text-primary border-primary border-b pb-1'
                : 'text-muted-foreground hover:text-primary',
            ]}
          >
            <Icon name="book-open-text" size={13} strokeWidth={1.75} />
            {i18n.nav.writing}
          </a>
          <a
            href={`/${lang}/about`}
            class:list={[
              'nav-link inline-flex items-center gap-1.5 font-mono text-[0.68rem] tracking-[0.16em] uppercase transition-colors',
              isAboutActive
                ? 'text-primary border-primary border-b pb-1'
                : 'text-muted-foreground hover:text-primary',
            ]}
          >
            <Icon name="user-round" size={13} strokeWidth={1.75} />
            {i18n.nav.about}
          </a>
          <a
            href="/rss.xml"
            class="nav-badge border-border text-muted-foreground hover:border-primary hover:text-primary inline-flex items-center gap-1.5 rounded border px-3 py-1.5 font-mono text-[0.65rem] tracking-[0.12em] uppercase transition-colors"
          >
            <Icon name="rss" size={13} strokeWidth={1.75} />
            {i18n.nav.rss}
          </a>
        </nav>

        <div class="flex items-center gap-2">
          <button
            type="button"
            data-theme-toggle
            data-theme-dark-label={i18n.nav.themeDark}
            data-theme-light-label={i18n.nav.themeLight}
            aria-pressed="true"
            title={i18n.nav.toggleTheme}
            class="border-border text-muted-foreground hover:border-primary hover:text-primary hidden h-9 w-9 items-center justify-center rounded border font-mono text-xs transition-colors sm:flex"
          >
            <Icon name="sun" data-theme-icon="light" size={15} strokeWidth={1.75} />
            <Icon name="moon" data-theme-icon="dark" size={15} strokeWidth={1.75} class="hidden" />
          </button>
          <div data-testid="header-language-switcher" class="hidden sm:block">
            <LanguageSwitcher
              currentLang={lang}
              currentPath={currentPath}
              {...alternatePaths && { alternatePaths }}
              label={i18n.language.navigation}
              languageNames={i18n.language.names}
              getSwitchLabel={i18n.language.switchTo}
            />
          </div>
          <details class="relative md:hidden">
            <summary
              class="border-border text-muted-foreground hover:border-primary hover:text-primary flex h-9 w-9 list-none items-center justify-center rounded border font-mono text-sm transition-colors"
              aria-label={i18n.nav.menu}
            >
              <Icon name="menu" size={16} strokeWidth={1.75} />
            </summary>
            <div
              class="border-border bg-background absolute top-12 right-0 w-56 rounded-lg border p-3 shadow-2xl"
            >
              <nav class="flex flex-col gap-1 font-mono text-xs tracking-[0.16em] uppercase">
                <a
                  href={`/${lang}`}
                  class="hover:bg-card hover:text-primary inline-flex items-center gap-2 rounded px-3 py-3"
                  ><Icon name="house" size={14} strokeWidth={1.75} />{i18n.schema.home}</a
                >
                <a
                  href={`/${lang}/blog`}
                  class="hover:bg-card hover:text-primary inline-flex items-center gap-2 rounded px-3 py-3"
                  ><Icon name="book-open-text" size={14} strokeWidth={1.75} />{i18n.nav.writing}</a
                >
                <a
                  href={`/${lang}/about`}
                  class="hover:bg-card hover:text-primary inline-flex items-center gap-2 rounded px-3 py-3"
                  ><Icon name="user-round" size={14} strokeWidth={1.75} />{i18n.nav.about}</a
                >
                <a
                  href="/rss.xml"
                  class="hover:bg-card hover:text-primary inline-flex items-center gap-2 rounded px-3 py-3"
                  ><Icon name="rss" size={14} strokeWidth={1.75} />{i18n.nav.rss}</a
                >
                <button
                  type="button"
                  data-theme-toggle
                  data-theme-dark-label={i18n.nav.themeDark}
                  data-theme-light-label={i18n.nav.themeLight}
                  class="text-muted-foreground hover:bg-card hover:text-primary inline-flex items-center gap-2 rounded px-3 py-3 text-left"
                  ><Icon name="sun" data-theme-icon="light" size={14} strokeWidth={1.75} /><Icon
                    name="moon"
                    data-theme-icon="dark"
                    size={14}
                    strokeWidth={1.75}
                    class="hidden"
                  />{i18n.nav.toggleTheme}</button
                >
                <div class="border-border mt-2 border-t pt-2">
                  <LanguageSwitcher
                    currentLang={lang}
                    currentPath={currentPath}
                    {...alternatePaths && { alternatePaths }}
                    label={i18n.language.navigation}
                    languageNames={i18n.language.names}
                    getSwitchLabel={i18n.language.switchTo}
                  />
                </div>
              </nav>
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>

    <footer class="border-border border-t">
      <div
        class="container flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <span class="text-muted-foreground font-mono text-[0.65rem] tracking-[0.14em] uppercase">
          DanhThanh.dev © {new Date().getFullYear()}
        </span>
        <nav class="flex items-center gap-6" aria-label={i18n.footer.links}>
          <span class="sr-only">{i18n.footer.links}</span>
          <a
            href={`mailto:${SITE.email}`}
            class="text-muted-foreground hover:text-primary inline-flex items-center gap-1.5 font-mono text-[0.65rem] tracking-[0.14em] uppercase transition-colors"
            ><Icon name="mail" size={13} strokeWidth={1.75} />{i18n.footer.collaboration}</a
          >
          <a
            href={SITE.social.github}
            class="text-muted-foreground hover:text-primary inline-flex items-center gap-1.5 font-mono text-[0.65rem] tracking-[0.14em] uppercase transition-colors"
            ><Icon name="code" size={13} strokeWidth={1.75} />{i18n.footer.github}</a
          >
          <a
            href="/rss.xml"
            class="text-muted-foreground hover:text-primary inline-flex items-center gap-1.5 font-mono text-[0.65rem] tracking-[0.14em] uppercase transition-colors"
            ><Icon name="rss" size={13} strokeWidth={1.75} />{i18n.footer.rss}</a
          >
          <a
            href={SITE.social.linkedin}
            class="text-muted-foreground hover:text-primary inline-flex items-center gap-1.5 font-mono text-[0.65rem] tracking-[0.14em] uppercase transition-colors"
            ><Icon name="contact" size={13} strokeWidth={1.75} />{i18n.footer.linkedin}</a
          >
        </nav>
        <div data-testid="footer-language-switcher" class="sm:hidden">
          <LanguageSwitcher
            currentLang={lang}
            currentPath={currentPath}
            {...alternatePaths && { alternatePaths }}
            label={i18n.language.footerNavigation}
            languageNames={i18n.language.names}
            getSwitchLabel={i18n.language.switchTo}
          />
        </div>
      </div>
    </footer>
  </body>
</html>
