---
import BaseLayout from '@/layouts/BaseLayout.astro'
import HeroSection from '@/components/HeroSection.astro'
import FeaturedWork from '@/components/FeaturedWork.astro'
import FollowWritingSection from '@/components/FollowWritingSection.astro'
import TagCloudSection from '@/components/TagCloudSection.astro'
import {
  getLocalizedPosts,
  getAllCategories,
  getAllTags,
  type SupportedLocale,
} from '@/lib/content-queries'
import { getTranslations } from '@/lib/i18n'
import { getSiteOrigin, SITE } from '@/lib/site'
import { getHomePath } from '@/lib/routes'
import { isValidLocale } from '@/lib/content-utils'
import { buildWebSiteSchema, createSeoDocument, getLocaleNeutralAlternates } from '@/lib/seo'

export const prerender = true

export async function getStaticPaths() {
  const locales: SupportedLocale[] = ['vi', 'en']
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }))
}

const langParam = Astro.params.lang ?? 'vi'
const lang = isValidLocale(langParam) ? langParam : 'vi'
const siteUrl = getSiteOrigin()
const i18n = getTranslations(lang)
const posts = await getLocalizedPosts(lang)
const categories = await getAllCategories(lang)
const allTags = await getAllTags(lang)
const featuredPost = posts[0] ?? null
const recentPosts = posts.slice(1, 4)
const homepageDescription = i18n.home.description

const tagCounts = posts.reduce((acc, post) => {
  post.data.tags.forEach((tag) => {
    acc.set(tag, (acc.get(tag) ?? 0) + 1)
  })
  return acc
}, new Map<string, number>())

const sortedTags = [...tagCounts.entries()].sort(
  (tagEntryLeft, tagEntryRight) => tagEntryRight[1] - tagEntryLeft[1]
)

const homePath = getHomePath(lang)
const seo = createSeoDocument({
  title: `${SITE.name} | ${i18n.home.title}`,
  description: homepageDescription,
  path: homePath,
  lang,
  kind: 'indexable',
  siteOrigin: siteUrl,
  alternates: getLocaleNeutralAlternates('/', siteUrl),
  jsonLd: buildWebSiteSchema(SITE.name, siteUrl, homepageDescription, SITE.author, [
    SITE.social.github,
    SITE.social.linkedin,
  ]),
  author: SITE.author,
})
---

<BaseLayout seo={seo} currentPath={homePath}>
  <HeroSection
    posts={posts.length}
    categories={categories.length}
    allTags={allTags.length}
    i18n={i18n.hero}
    lang={lang}
    {...featuredPost?.data.coverImage ? { heroImage: featuredPost.data.coverImage } : {}}
  />

  <FeaturedWork
    featuredPost={featuredPost}
    recentPosts={recentPosts}
    lang={lang}
    i18n={i18n.home}
  />

  <TagCloudSection
    tags={sortedTags.map(([name, count]) => ({ name, count }))}
    lang={lang}
    title={i18n.blog.stats.tags}
    linkText={i18n.archive.openFullArchive}
  />

  <FollowWritingSection lang={lang} />
</BaseLayout>
