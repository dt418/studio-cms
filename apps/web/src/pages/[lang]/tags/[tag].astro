---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogFilter from '@/components/BlogFilter.astro'
import BlogCard from '@/components/BlogCard.astro'
import BackLink from '@/components/Blog/BackLink.astro'
import TagCloud from '@/components/Blog/TagCloud.astro'
import {
  getPostsByTag,
  getAllTags,
  getAllCategories,
  type SupportedLocale,
} from '@/lib/content-queries'
import { getSiteOrigin, SITE, toCanonicalUrl } from '@/lib/site'
import { getTranslations } from '@/lib/i18n'
import { getTagPath, getBlogPath, getHomePath } from '@/lib/routes'
import { isValidLocale, SUPPORTED_LOCALES } from '@/lib/content-utils'
import {
  buildBreadcrumbList,
  buildCollectionPageSchema,
  createSeoDocument,
  getLocaleNeutralAlternates,
} from '@/lib/seo'

export const prerender = true

export async function getStaticPaths() {
  const locales: SupportedLocale[] = ['vi', 'en']
  const paths: {
    params: { lang: SupportedLocale; tag: string }
    props: { tag: string; locale: SupportedLocale }
  }[] = []

  for (const locale of locales) {
    const tags = await getAllTags(locale)
    for (const tag of tags) {
      paths.push({
        params: { lang: locale, tag },
        props: { tag, locale },
      })
    }
  }

  return paths
}

const langParam = Astro.params.lang ?? 'vi'
const lang = isValidLocale(langParam) ? langParam : 'vi'
const siteUrl = getSiteOrigin()
const i18n = getTranslations(lang)
const rawTag = Astro.params.tag ?? ''
const tag =
  Astro.props.tag ??
  (() => {
    try {
      return decodeURIComponent(rawTag)
    } catch {
      return rawTag
    }
  })()

const posts = await getPostsByTag(tag, lang)
const allTags = await getAllTags(lang)
const allCategories = await getAllCategories(lang)
const tagLocales = (
  await Promise.all(
    SUPPORTED_LOCALES.map(
      async (locale) => [locale, (await getAllTags(locale)).includes(tag)] as const
    )
  )
)
  .filter(([, available]) => available)
  .map(([locale]) => locale)

const alternatePaths = Object.fromEntries(
  SUPPORTED_LOCALES.map((locale) => [
    locale,
    tagLocales.includes(locale) ? getTagPath(tag, locale) : getBlogPath(locale),
  ])
) as Partial<Record<SupportedLocale, string>>

const tagPath = getTagPath(tag, lang)
const canonicalUrl = toCanonicalUrl(tagPath, siteUrl)
const jsonLd = [
  buildCollectionPageSchema({
    name: i18n.schema.postsTagged(tag),
    description: i18n.schema.allPostsTaggedWith(tag),
    url: canonicalUrl,
    siteName: SITE.name,
    siteUrl,
    lang,
  }),
  buildBreadcrumbList({
    homeLabel: i18n.schema.home,
    homeUrl: toCanonicalUrl(getHomePath(lang), siteUrl),
    blogLabel: i18n.schema.blog,
    blogUrl: toCanonicalUrl(getBlogPath(lang), siteUrl),
    currentLabel: tag,
    currentUrl: canonicalUrl,
  }),
]
const seo = createSeoDocument({
  kind: 'indexable',
  title: `${tag} | ${SITE.name}`,
  description: i18n.schema.allPostsTaggedWith(tag),
  path: tagPath,
  lang,
  siteOrigin: siteUrl,
  alternates: getLocaleNeutralAlternates(`/tags/${encodeURIComponent(tag)}`, siteUrl, tagLocales),
  jsonLd,
})
---

<BaseLayout seo={seo} currentPath={tagPath} alternatePaths={alternatePaths}>
  <section class="border-b border-border/80">
    <div class="container py-10 sm:py-13 lg:py-14">
      <BackLink href={getBlogPath(lang)} text={i18n.tags.backToBlog} />
      <div class="mt-6 flex items-center gap-3">
        <span class="bg-primary h-px w-8"></span>
        <span class="editorial-kicker">{i18n.tags.title}</span>
      </div>
      <h1 class="editorial-display mt-4 text-[clamp(2.8rem,5vw,4.9rem)] leading-[0.95] font-semibold tracking-[-0.052em]">
        #{tag}
      </h1>
      <p class="text-muted-foreground mt-4 max-w-xl text-base leading-7 sm:text-lg">
        {posts.length} {i18n.tags.postsTaggedWith} "{tag}"
      </p>
    </div>
  </section>

  <section class="container py-9 sm:py-11 lg:py-13">
    <div class="border-border border-b pb-7">
      <TagCloud tags={allTags} currentTag={tag} locale={lang} heading={i18n.tags.heading} />
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>

    <div class="mt-14 border-t border-border pt-8">
      <h2 class="editorial-kicker mb-5">{i18n.tags.searchFilter}</h2>
      <BlogFilter
        posts={posts}
        categories={allCategories}
        tags={allTags}
        locale={lang}
        initialTag={tag}
        i18n={i18n.filter}
      />
    </div>
  </section>
</BaseLayout>
