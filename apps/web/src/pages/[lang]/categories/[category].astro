---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogFilter from '@/components/BlogFilter.astro'
import BlogCard from '@/components/BlogCard.astro'
import BackLink from '@/components/Blog/BackLink.astro'
import CategoryCloud from '@/components/Blog/CategoryCloud.astro'
import {
  getPostsByCategory,
  getAllCategories,
  getAllTags,
  type SupportedLocale,
} from '@/lib/content-queries'
import { getSiteOrigin, SITE, toCanonicalUrl } from '@/lib/site'
import { getTranslations } from '@/lib/i18n'
import { getCategoryPath, getBlogPath, getHomePath } from '@/lib/routes'
import { isValidLocale, SUPPORTED_LOCALES } from '@/lib/content-utils'
import {
  buildBreadcrumbList,
  buildCollectionPageSchema,
  createSeoDocument,
  getLocaleNeutralAlternates,
} from '@/lib/seo'

export const prerender = true

export async function getStaticPaths() {
  const locales: SupportedLocale[] = ['vi', 'en']
  const paths: {
    params: { lang: SupportedLocale; category: string }
    props: { category: string; locale: SupportedLocale }
  }[] = []

  for (const locale of locales) {
    const categories = await getAllCategories(locale)
    for (const category of categories) {
      paths.push({
        params: { lang: locale, category },
        props: { category, locale },
      })
    }
  }

  return paths
}

const langParam = Astro.params.lang ?? 'vi'
const lang = isValidLocale(langParam) ? langParam : 'vi'
const siteUrl = getSiteOrigin()
const i18n = getTranslations(lang)
const rawCategory = Astro.params.category ?? ''
const category =
  Astro.props.category ??
  (() => {
    try {
      return decodeURIComponent(rawCategory)
    } catch {
      return rawCategory
    }
  })()

const posts = await getPostsByCategory(category, lang)
const allCategories = await getAllCategories(lang)
const allTags = await getAllTags(lang)
const categoryLocales = (
  await Promise.all(
    SUPPORTED_LOCALES.map(
      async (locale) => [locale, (await getAllCategories(locale)).includes(category)] as const
    )
  )
)
  .filter(([, available]) => available)
  .map(([locale]) => locale)

const alternatePaths = Object.fromEntries(
  SUPPORTED_LOCALES.map((locale) => [
    locale,
    categoryLocales.includes(locale) ? getCategoryPath(category, locale) : getBlogPath(locale),
  ])
) as Partial<Record<SupportedLocale, string>>

const categoryPath = getCategoryPath(category, lang)
const canonicalUrl = toCanonicalUrl(categoryPath, siteUrl)
const jsonLd = [
  buildCollectionPageSchema({
    name: i18n.schema.postsIn(category),
    description: i18n.schema.allPostsInCategory(category),
    url: canonicalUrl,
    siteName: SITE.name,
    siteUrl,
    lang,
  }),
  buildBreadcrumbList({
    homeLabel: i18n.schema.home,
    homeUrl: toCanonicalUrl(getHomePath(lang), siteUrl),
    blogLabel: i18n.schema.blog,
    blogUrl: toCanonicalUrl(getBlogPath(lang), siteUrl),
    currentLabel: category,
    currentUrl: canonicalUrl,
  }),
]
const seo = createSeoDocument({
  kind: 'indexable',
  title: `${category} | ${SITE.name}`,
  description: i18n.schema.allPostsInCategory(category),
  path: categoryPath,
  lang,
  siteOrigin: siteUrl,
  alternates: getLocaleNeutralAlternates(
    `/categories/${encodeURIComponent(category)}`,
    siteUrl,
    categoryLocales
  ),
  jsonLd,
})
---

<BaseLayout seo={seo} currentPath={categoryPath} alternatePaths={alternatePaths}>
  <section class="editorial-masthead">
    <div class="container py-11 sm:py-14 lg:py-16">
      <div class="relative z-10 max-w-4xl">
        <BackLink href={getBlogPath(lang)} text={i18n.categories.backToBlog} />
        <div class="mt-6 flex items-center gap-3">
          <span class="bg-primary h-px w-8"></span>
          <span class="editorial-kicker">{i18n.categories.title}</span>
        </div>
        <h1 class="editorial-display mt-4 text-[clamp(2.9rem,5.4vw,5.2rem)] leading-[0.94] font-semibold tracking-[-0.055em]">
          {category}
        </h1>
        <p class="text-muted-foreground mt-4 max-w-2xl text-base leading-7 sm:text-lg">
          {posts.length} {i18n.categories.postsIn} "{category}"
        </p>
      </div>
    </div>
  </section>

  <section class="container py-9 sm:py-11 lg:py-14">
    <div class="border-border border-b pb-7">
      <CategoryCloud
        categories={allCategories}
        currentCategory={category}
        locale={lang}
        heading={i18n.categories.heading}
      />
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} />)}
    </div>

    <div class="mt-14 border-t border-border pt-8">
      <h2 class="editorial-kicker mb-5">{i18n.categories.searchFilter}</h2>
      <BlogFilter
        posts={posts}
        categories={allCategories}
        tags={allTags}
        locale={lang}
        initialCategory={category}
        i18n={i18n.filter}
      />
    </div>
  </section>
</BaseLayout>
