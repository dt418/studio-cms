---
import AboutContact from '@/components/About/AboutContact.astro'
import AboutHero from '@/components/About/AboutHero.astro'
import AboutPrinciples from '@/components/About/AboutPrinciples.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getTranslations } from '@/lib/i18n'
import { getSiteOrigin, SITE, toCanonicalUrl } from '@/lib/site'
import { isValidLocale } from '@/lib/content-utils'
import { getAuthorInitials } from '@/lib/post'
import { getAboutPath, getHomePath, RSS_PATH } from '@/lib/routes'
import type { SupportedLocale } from '@/lib/content-queries'
import {
  buildBreadcrumbList,
  buildProfilePageSchema,
  createSeoDocument,
  getLocaleNeutralAlternates,
} from '@/lib/seo'

export const prerender = true

export async function getStaticPaths() {
  const locales: SupportedLocale[] = ['vi', 'en']
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }))
}

const langParam = Astro.params.lang ?? 'vi'
const lang = isValidLocale(langParam) ? langParam : 'vi'
const siteUrl = getSiteOrigin()
const i18n = getTranslations(lang)
const about = i18n.about

const contactItems = [
  {
    marker: about.contact.emailMarker,
    label: about.contact.email,
    value: SITE.email,
    href: `mailto:${SITE.email}`,
  },
  {
    marker: about.contact.githubMarker,
    label: about.contact.github,
    value: about.contact.githubHandle,
    href: SITE.social.github,
    external: true,
  },
  {
    marker: about.contact.linkedinMarker,
    label: about.contact.linkedin,
    value: about.contact.linkedinHandle,
    href: SITE.social.linkedin,
    external: true,
  },
  {
    marker: about.contact.rssMarker,
    label: about.contact.rss,
    value: RSS_PATH,
    href: RSS_PATH,
  },
]

const aboutPath = getAboutPath(lang)
const canonicalUrl = toCanonicalUrl(aboutPath, siteUrl)
const seo = createSeoDocument({
  kind: 'indexable',
  title: `${about.pageTitle} | ${SITE.name}`,
  description: about.metaDescription,
  path: aboutPath,
  lang,
  siteOrigin: siteUrl,
  alternates: getLocaleNeutralAlternates('/about', siteUrl),
  author: SITE.author,
  jsonLd: [
    buildProfilePageSchema({
      name: about.pageTitle,
      description: about.metaDescription,
      url: canonicalUrl,
      siteName: SITE.name,
      siteUrl,
      lang,
    }),
    buildBreadcrumbList({
      homeLabel: i18n.schema.home,
      homeUrl: toCanonicalUrl(getHomePath(lang), siteUrl),
      currentLabel: i18n.schema.about,
      currentUrl: canonicalUrl,
    }),
  ],
})
---

<BaseLayout seo={seo} currentPath={aboutPath}>
  <section class="container py-14 sm:py-20 lg:py-24">
    <nav
      class="text-muted-foreground mb-6 flex items-center gap-2 text-sm"
      aria-label={i18n.breadcrumb.label}
    >
      <a href={getHomePath(lang)} class="hover:text-foreground transition-colors"
        >{i18n.schema.home}</a
      >
      <span aria-hidden="true" class="text-muted-foreground/40">/</span>
      <span class="text-foreground" aria-current="page">{i18n.schema.about}</span>
    </nav>

    <AboutHero
      eyebrow={about.eyebrow}
      title={SITE.author}
      intro={about.intro}
      monogram={getAuthorInitials(SITE.author)}
      monogramLabel={about.monogramLabel}
    />
    <AboutPrinciples
      principleIndex={about.principleIndex}
      principleTitle={about.principleTitle}
      principleBody={about.principleBody}
      stackIndex={about.stackIndex}
      stackTitle={about.stackTitle}
      stack={about.stack}
    />
    <AboutContact title={about.contactTitle} items={contactItems} />
  </section>
</BaseLayout>
