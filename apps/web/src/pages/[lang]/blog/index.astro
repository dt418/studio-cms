---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogFilter from '@/components/BlogFilter.astro'
import BlogHeader from '@/components/Blog/BlogHeader.astro'
import StatsGrid from '@/components/Blog/StatsGrid.astro'
import {
  getLocalizedPosts,
  getAllTags,
  getAllCategories,
  type SupportedLocale,
} from '@/lib/content-queries'
import { getSiteOrigin, SITE, toAbsoluteUrl } from '@/lib/site'
import { getTranslations } from '@/lib/i18n'
import { getBlogPath, getHomePath } from '@/lib/routes'
import { isValidLocale } from '@/lib/content-utils'
import {
  buildBreadcrumbList,
  buildCollectionPageSchema,
  createSeoDocument,
  getLocaleNeutralAlternates,
} from '@/lib/seo'

export const prerender = true

export async function getStaticPaths() {
  const locales: SupportedLocale[] = ['vi', 'en']
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }))
}

const langParam = Astro.params.lang ?? 'vi'
const lang = isValidLocale(langParam) ? langParam : 'vi'
const siteUrl = getSiteOrigin()

const i18n = getTranslations(lang)
const posts = await getLocalizedPosts(lang)
const categories = await getAllCategories(lang)
const tags = await getAllTags(lang)

const stats = [
  { value: posts.length, label: i18n.blog.stats.publishedNotes },
  { value: categories.length, label: i18n.blog.stats.categories },
  { value: tags.length, label: i18n.blog.stats.tags },
  { value: new Date().getFullYear(), label: i18n.blog.stats.archiveSnapshot },
]

const blogPath = getBlogPath(lang)
const canonicalUrl = toAbsoluteUrl(blogPath, siteUrl)
const seo = createSeoDocument({
  kind: 'indexable',
  title: `${i18n.blog.archive} | ${SITE.name}`,
  description: i18n.blog.description,
  path: blogPath,
  lang,
  siteOrigin: siteUrl,
  alternates: getLocaleNeutralAlternates('/blog', siteUrl),
  jsonLd: [
    buildCollectionPageSchema({
      name: `${SITE.name} - ${i18n.blog.archive}`,
      description: i18n.blog.description,
      url: canonicalUrl,
      siteName: SITE.name,
      siteUrl,
      lang,
    }),
    buildBreadcrumbList({
      homeLabel: i18n.schema.home,
      homeUrl: toAbsoluteUrl(getHomePath(lang), siteUrl),
      currentLabel: i18n.schema.blog,
      currentUrl: canonicalUrl,
    }),
  ],
})
---

<BaseLayout seo={seo} currentPath={blogPath}>
  <BlogHeader
    title={i18n.blog.archive}
    description={i18n.blog.description}
    badge={i18n.blog.archive}
  />

  <section class="container py-10">
    <StatsGrid stats={stats} />
    <BlogFilter
      posts={posts}
      categories={categories}
      tags={tags}
      locale={lang}
      i18n={i18n.filter}
    />
  </section>
</BaseLayout>
