---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostMetaCard from '@/components/Blog/PostMetaCard.astro'
import TableOfContents from '@/components/Blog/TableOfContents.astro'
import PostHero from '@/components/Blog/PostHero.astro'
import ArticleContent from '@/components/Blog/ArticleContent.astro'
import RelatedPosts from '@/components/Blog/RelatedPosts.astro'
import PostFAQ from '@/components/Blog/PostFAQ.astro'
import {
  getAllPosts,
  getLocalizedPosts,
  getPostSlug,
  type SupportedLocale,
} from '@/lib/content-queries'
import { readingTime } from '@/lib/reading-time'
import { render } from 'astro:content'
import { getSiteOrigin, SITE, toCanonicalUrl } from '@/lib/site'
import { getAdjacentPosts } from '@/lib/post'
import { getOptimizedCoverImage } from '@/lib/cover-images'
import { formatDate } from '@/lib/date'
import { getBlogPath, getHomePath, getPostPath } from '@/lib/routes'
import { getTranslations } from '@/lib/i18n'
import { isValidLocale } from '@/lib/content-utils'
import { isPublicPost } from '@/lib/post-visibility'
import {
  buildArticleSchema,
  buildBreadcrumbList,
  createSeoDocument,
  getPostAlternateLinks,
  resolvePostCanonical,
  resolvePostDescription,
  resolveSeoImage,
  resolveSeoTitle,
} from '@/lib/seo'
import { createSafeSlug, getUniqueId } from '../../../../rehype-vietnamese-slug.mjs'
import type { CollectionEntry } from 'astro:content'

export const prerender = true

export async function getStaticPaths() {
  const locales: SupportedLocale[] = ['vi', 'en']
  const paths: {
    params: { lang: SupportedLocale; slug: string }
    props: {
      post: CollectionEntry<'posts'>
      allPosts: CollectionEntry<'posts'>[]
      translationPosts: CollectionEntry<'posts'>[]
    }
  }[] = []

  const translationPosts = await getAllPosts()
  for (const locale of locales) {
    const posts = await getLocalizedPosts(locale, { includeNoindex: true })
    const publicPosts = posts.filter((post) => isPublicPost(post))

    for (const post of posts) {
      paths.push({
        params: { lang: locale, slug: getPostSlug(post) },
        props: { post, allPosts: publicPosts, translationPosts },
      })
    }
  }

  return paths
}

interface Props {
  post: CollectionEntry<'posts'>
  allPosts: CollectionEntry<'posts'>[]
  translationPosts: CollectionEntry<'posts'>[]
}

const siteUrl = getSiteOrigin()
const langParam = Astro.params.lang ?? 'vi'
const lang = isValidLocale(langParam) ? langParam : 'vi'
const slug = Astro.params.slug
const { post, allPosts, translationPosts } = Astro.props as Props

const { Content, headings } = await render(post)
const normalizedHeadingCounts = new Map<string, number>()
const normalizedHeadings = headings.map((heading) => ({
  ...heading,
  slug: getUniqueId(createSafeSlug(heading.text), normalizedHeadingCounts),
}))

const {
  title,
  coverImage,
  publishedAt,
  updatedAt,
  tags,
  category,
  author = SITE.author,
  faq,
} = post.data

const formattedDate = formatDate(publishedAt, lang)
const updatedDate = updatedAt ? formatDate(updatedAt, lang) : null
const publishedTime = publishedAt.toISOString()
const modifiedTime = updatedAt?.toISOString() ?? publishedTime

const bodyText = post.body ?? ''
const wordCount = bodyText.trim().split(/\s+/).filter(Boolean).length
const readingTimeMin = readingTime(bodyText)

const i18n = getTranslations(lang)
const description = resolvePostDescription(post)
const seoTitle = resolveSeoTitle(title, SITE.name)

const currentIndex = allPosts.findIndex((entry) => getPostSlug(entry) === slug)
const { prev: prevPost, next: nextPost } = getAdjacentPosts(allPosts, currentIndex)

const relatedPosts = allPosts
  .filter((entry) => getPostSlug(entry) !== slug && entry.data.category === category)
  .slice(0, 3)

const postPath = getPostPath(post)
const canonicalUrl = resolvePostCanonical(post, siteUrl)
const alternateLinks = getPostAlternateLinks(post, translationPosts, siteUrl)

const coverMetadata = coverImage ? getOptimizedCoverImage(coverImage) : undefined
const coverImageType =
  coverMetadata?.format === 'png'
    ? 'image/png'
    : coverMetadata?.format === 'webp'
      ? 'image/webp'
      : undefined
const seoImage =
  coverMetadata && coverImageType
    ? resolveSeoImage(
        {
          url: coverMetadata.src,
          type: coverImageType,
          width: coverMetadata.width,
          height: coverMetadata.height,
        },
        siteUrl
      )
    : undefined
const articleJsonLd = buildArticleSchema({
  title,
  description,
  url: canonicalUrl,
  ...(seoImage ? { image: seoImage.url } : {}),
  publishedAt,
  ...(updatedAt && { updatedAt }),
  author,
  siteName: SITE.name,
  siteUrl,
  keywords: [...tags, category],
})

const breadcrumbJsonLd = buildBreadcrumbList({
  homeLabel: i18n.schema.home,
  homeUrl: toCanonicalUrl(getHomePath(lang), siteUrl),
  blogLabel: i18n.schema.blog,
  blogUrl: toCanonicalUrl(getBlogPath(lang), siteUrl),
  currentLabel: title,
  currentUrl: canonicalUrl,
})

const faqJsonLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null

const pageJsonLd = faqJsonLd
  ? [articleJsonLd, breadcrumbJsonLd, faqJsonLd]
  : [articleJsonLd, breadcrumbJsonLd]

const seo = createSeoDocument({
  kind: post.data.noindex ? 'noindex-content' : 'indexable',
  title: seoTitle,
  description,
  path: postPath,
  canonicalUrl,
  lang,
  siteOrigin: siteUrl,
  alternates: alternateLinks,
  author,
  type: 'article',
  publishedTime: publishedAt,
  modifiedTime: updatedAt ?? publishedAt,
  jsonLd: pageJsonLd,
  ...(seoImage && { image: seoImage }),
})
---

<style is:global>
  [data-pagefind-filter],
  [data-pagefind-sort] {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>

<BaseLayout seo={seo} currentPath={postPath}>
  <article
    class="min-h-screen"
    transition:name="post-detail"
    {...isPublicPost(post) && { 'data-pagefind-body': true }}
  >
    <span data-pagefind-filter="category">{category}</span>
    {tags.map((tag) => <span data-pagefind-filter="tag">{tag}</span>)}
    <span data-pagefind-sort="date">{publishedAt.getTime()}</span>
    <span data-pagefind-sort="title">{title}</span>
    <PostHero
      category={category}
      title={title}
      excerpt={description}
      tags={tags}
      publishedAt={formattedDate}
      publishedAtIso={publishedTime}
      readingTime={readingTimeMin}
      lang={lang}
      i18n={{ ...i18n.schema, minRead: i18n.post.minRead, breadcrumbLabel: i18n.breadcrumb.label }}
      {...coverImage && { coverImage }}
    />

    <div class="container py-8 lg:py-12">
      <div class="mx-auto grid grid-cols-1 gap-8 lg:grid-cols-[200px_1fr_240px] lg:gap-12">
        <aside class="order-2 lg:order-1">
          <TableOfContents headings={normalizedHeadings} i18n={i18n.post} />
        </aside>

        <ArticleContent
          tags={tags}
          author={author}
          {...prevPost && { prevPost }}
          {...nextPost && { nextPost }}
          i18n={i18n}
        >
          <Content />
        </ArticleContent>

        <aside class="order-3 hidden lg:block">
          <PostMetaCard
            author={author}
            publishedAt={formattedDate}
            publishedAtIso={publishedTime}
            readingTime={readingTimeMin}
            wordCount={wordCount}
            i18n={i18n.post}
            {...updatedDate && { updatedAt: updatedDate, updatedAtIso: modifiedTime }}
          />
        </aside>
      </div>
    </div>

    <PostFAQ items={faq} i18n={i18n.post} />

    <RelatedPosts relatedPosts={relatedPosts} i18n={i18n.post} />
  </article>
</BaseLayout>
