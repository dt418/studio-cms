---
interface Props {
  principleIndex: string
  principleTitle: string
  principleBody: string
  stackIndex: string
  stackTitle: string
  stack: string[]
}

const { principleIndex, principleTitle, principleBody, stackIndex, stackTitle, stack } = Astro.props
---

<div class="grid gap-0 py-12 md:grid-cols-2 lg:py-18">
  <article class="border-border border-b py-8 pr-0 md:border-r md:border-b-0 md:pr-10 lg:py-10 lg:pr-14">
    <div class="mb-5 flex items-center gap-4">
      <span class="text-primary font-mono text-xs tracking-[0.18em]">{principleIndex}</span>
      <span class="bg-border h-px flex-1" aria-hidden="true"></span>
    </div>
    <h2 class="editorial-display text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl">
      {principleTitle}
    </h2>
    <p class="text-muted-foreground mt-5 max-w-prose text-sm leading-7 text-pretty sm:text-base sm:leading-8">
      {principleBody}
    </p>
  </article>

  <article class="border-border py-8 md:pl-10 lg:py-10 lg:pl-14">
    <div class="mb-5 flex items-center gap-4">
      <span class="text-primary font-mono text-xs tracking-[0.18em]">{stackIndex}</span>
      <span class="bg-border h-px flex-1" aria-hidden="true"></span>
    </div>
    <h2 class="editorial-display text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl">
      {stackTitle}
    </h2>
    <div class="mt-6 flex flex-wrap gap-x-5 gap-y-3">
      {
        stack.map((item) => (
          <span class="text-foreground border-border border-b pb-1 font-mono text-xs tracking-[0.06em]">
            {item}
          </span>
        ))
      }
    </div>
  </article>
</div>
