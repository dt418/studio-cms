---
interface Props {
  principleIndex: string
  principleTitle: string
  principleBody: string
  stackIndex: string
  stackTitle: string
  stack: string[]
}

const { principleIndex, principleTitle, principleBody, stackIndex, stackTitle, stack } = Astro.props
---

<div class="grid gap-6 py-12 md:grid-cols-2 lg:py-16">
  <article class="border-border bg-card/30 rounded-xl border p-6 sm:p-8">
    <div class="mb-5 flex items-start gap-4">
      <span class="text-primary font-mono text-xs tracking-[0.18em]">{principleIndex}</span>
      <h2 class="font-serif text-2xl font-bold tracking-tight sm:text-3xl">{principleTitle}</h2>
    </div>
    <p class="text-muted-foreground max-w-prose text-sm leading-7 sm:text-base">{principleBody}</p>
  </article>

  <article class="border-border bg-card/30 rounded-xl border p-6 sm:p-8">
    <div class="mb-5 flex items-start gap-4">
      <span class="text-primary font-mono text-xs tracking-[0.18em]">{stackIndex}</span>
      <h2 class="font-serif text-2xl font-bold tracking-tight sm:text-3xl">{stackTitle}</h2>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        stack.map((item) => (
          <span class="border-border bg-background text-muted-foreground rounded border px-3 py-2 font-mono text-xs">
            {item}
          </span>
        ))
      }
    </div>
  </article>
</div>
