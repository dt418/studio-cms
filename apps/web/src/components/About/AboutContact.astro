---
interface ContactItem {
  marker: string
  label: string
  value: string
  href: string
  external?: boolean
}

interface Props {
  title: string
  items: ContactItem[]
}

const { title, items } = Astro.props
---

<section class="border-border border-t py-12 sm:py-14 lg:py-16">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,0.45fr)_minmax(0,1fr)] lg:items-start">
    <div>
      <span class="editorial-kicker">{title}</span>
      <h2 class="editorial-display mt-4 max-w-md text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl">
        {title}
      </h2>
    </div>

    <div class="divide-border border-border divide-y border-y font-mono text-xs">
      {
        items.map((item) => (
          <a
            href={item.href}
            {...(item.external ? { target: '_blank', rel: 'noreferrer' } : {})}
            class="text-muted-foreground hover:text-primary group grid gap-3 py-4 transition-colors sm:grid-cols-[44px_140px_minmax(0,1fr)_auto] sm:items-center"
          >
            <span class="text-primary" aria-hidden="true">{item.marker}</span>
            <span class="text-foreground">{item.label}</span>
            <span class="truncate">{item.value}</span>
            <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">
              {item.external ? '↗' : '→'}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
