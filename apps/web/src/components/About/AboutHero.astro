---
interface Props {
  eyebrow: string
  title: string
  intro: string
  monogram: string
  monogramLabel: string
}

const { eyebrow, title, intro, monogram, monogramLabel } = Astro.props
---

<div class="about-editorial-hero grid gap-9 sm:gap-11 lg:grid-cols-[minmax(0,1.05fr)_minmax(17rem,0.48fr)] lg:items-end">
  <div class="relative z-10 max-w-4xl">
    <div class="mb-5 flex items-center gap-3">
      <span class="bg-primary h-px w-8"></span>
      <p class="editorial-kicker">{eyebrow}</p>
    </div>
    <h1 class="editorial-display max-w-3xl text-[clamp(3.25rem,6.3vw,5.8rem)] leading-[0.92] font-semibold tracking-[-0.06em]">
      {title}
    </h1>
    <p class="text-muted-foreground mt-6 max-w-[42rem] text-base leading-8 text-pretty sm:text-lg sm:leading-9">
      {intro}
    </p>
  </div>

  <div class="relative z-10 justify-self-start lg:justify-self-end">
    <div
      class="about-profile-visual relative flex aspect-[4/5] w-[min(72vw,18rem)] items-end overflow-hidden border border-border p-5 sm:w-72 sm:p-6"
      aria-label={monogramLabel}
    >
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_20%,color-mix(in_oklch,var(--primary)_26%,transparent),transparent_28%),linear-gradient(155deg,color-mix(in_oklch,var(--card)_88%,var(--background)),color-mix(in_oklch,var(--foreground)_30%,var(--background)))]" aria-hidden="true"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/62 to-transparent" aria-hidden="true"></div>
      <div class="relative z-10 flex w-full items-end justify-between gap-4 text-white">
        <span class="editorial-display text-6xl leading-none font-semibold tracking-[-0.08em] sm:text-7xl">
          {monogram}
        </span>
        <span class="font-mono text-[0.56rem] tracking-[0.15em] text-white/68 uppercase">profile / 2026</span>
      </div>
    </div>
  </div>
</div>
