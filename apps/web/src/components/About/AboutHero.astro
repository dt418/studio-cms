---
interface Props {
  eyebrow: string
  title: string
  intro: string
  monogram: string
  monogramLabel: string
}

const { eyebrow, title, intro, monogram, monogramLabel } = Astro.props
---

<div class="about-editorial-hero grid gap-10 sm:gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(260px,0.55fr)] lg:items-end">
  <div class="relative z-10 max-w-4xl">
    <div class="mb-6 flex items-center gap-3">
      <span class="bg-primary h-px w-10"></span>
      <p class="editorial-kicker">{eyebrow}</p>
    </div>
    <h1 class="editorial-display text-[clamp(4rem,8vw,8rem)] leading-[0.88] font-semibold tracking-[-0.065em]">
      {title}
    </h1>
    <p class="text-muted-foreground mt-8 max-w-2xl text-base leading-8 text-pretty sm:text-lg sm:leading-9">
      {intro}
    </p>
  </div>

  <div class="relative z-10 justify-self-start lg:justify-self-end">
    <div
      class="editorial-surface flex h-44 w-44 items-end justify-start rounded-[2rem] p-6 sm:h-56 sm:w-56"
      aria-label={monogramLabel}
    >
      <span class="editorial-display text-6xl leading-none font-semibold tracking-[-0.08em] sm:text-7xl">
        {monogram}
      </span>
      <span class="bg-primary absolute right-6 bottom-6 h-3 w-12" aria-hidden="true"></span>
    </div>
  </div>
</div>
