---
interface Props {
  label: string
  value: string
  category: string
  description: string
}

const { label, value, category, description } = Astro.props
---

<p class="text-muted-foreground font-mono text-[0.68rem] tracking-[0.18em] uppercase">
  {label}
</p>
<p
  class="text-foreground mt-4 font-serif text-[1.8rem] leading-none font-bold tracking-[-0.04em] sm:text-[2.2rem]"
>
  {value}
</p>
<p class="text-primary mt-2 font-mono text-[0.68rem] tracking-[0.18em] uppercase">
  {category}
</p>
<p class="text-muted-foreground mt-5 max-w-[30ch] text-sm leading-7">{description}</p>
