---
interface Props {
  title: string
  description: string
  badge?: string
}

const { title, description, badge } = Astro.props
---

<section class="editorial-masthead" style="view-transition-name: blog-header;">
  <div class="container py-11 sm:py-14 lg:py-16">
    <div class="relative z-10 grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.38fr)] lg:items-end">
      <div class="max-w-4xl">
        {badge && (
          <div class="mb-4 flex items-center gap-3">
            <span class="bg-primary h-px w-8"></span>
            <span class="editorial-kicker">{badge}</span>
          </div>
        )}
        <h1 class="editorial-display text-[clamp(3rem,6vw,5.4rem)] leading-[0.94] font-semibold tracking-[-0.055em]">
          {title}
        </h1>
        <p class="text-muted-foreground mt-4 max-w-2xl text-base leading-7 sm:text-lg sm:leading-8">
          {description}
        </p>
      </div>
      <div class="hidden justify-self-end lg:block" aria-hidden="true">
        <p class="editorial-display max-w-[15rem] rotate-[-4deg] text-2xl leading-tight italic text-muted-foreground/55">
          Better developers build a brighter web.
        </p>
      </div>
    </div>
  </div>
</section>
