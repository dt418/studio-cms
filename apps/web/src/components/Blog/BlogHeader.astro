---
interface Props {
  title: string
  description: string
  badge?: string
}

const { title, description, badge } = Astro.props
---

<section class="border-b border-white/5" style="view-transition-name: blog-header;">
  <div class="container py-14 sm:py-20">
    <div class="max-w-2xl">
      <div class="mb-3 flex items-center gap-2">
        <span
          class="bg-accent text-accent-foreground inline-flex items-center rounded px-2.5 py-1 font-mono text-xs font-semibold tracking-[0.16em] uppercase"
        >
          {badge}
        </span>
      </div>
      <h1 class="mb-3 font-serif text-4xl font-bold tracking-tight lg:text-6xl">{title}</h1>
      <p class="text-muted-foreground max-w-2xl text-base leading-relaxed sm:text-lg">
        {description}
      </p>
    </div>
  </div>
</section>
