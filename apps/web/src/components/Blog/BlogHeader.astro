---
interface Props {
  title: string
  description: string
  badge?: string
}

const { title, description, badge } = Astro.props
---

<section class="editorial-masthead" style="view-transition-name: blog-header;">
  <div class="container py-16 sm:py-24 lg:py-28">
    <div class="relative z-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(260px,0.42fr)] lg:items-end">
      <div class="max-w-4xl">
        {badge && (
          <div class="mb-5 flex items-center gap-3">
            <span class="bg-primary h-px w-10"></span>
            <span class="editorial-kicker">{badge}</span>
          </div>
        )}
        <h1 class="editorial-display text-5xl leading-[0.94] font-semibold tracking-[-0.055em] sm:text-7xl lg:text-8xl">
          {title}
        </h1>
        <p class="text-muted-foreground mt-6 max-w-2xl text-base leading-8 sm:text-lg sm:leading-9">
          {description}
        </p>
      </div>
      <div class="hidden justify-self-end lg:block" aria-hidden="true">
        <div class="editorial-surface h-28 w-64 rounded-2xl">
          <div class="absolute inset-x-5 top-6 h-px bg-border"></div>
          <div class="absolute inset-x-10 top-12 h-px bg-border/70"></div>
          <div class="absolute right-6 bottom-5 h-3 w-12 bg-primary/80"></div>
        </div>
      </div>
    </div>
  </div>
</section>
