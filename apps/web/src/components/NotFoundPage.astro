---
import type { Language } from '@/lib/i18n'
import { SITE } from '@/lib/site'

interface NotFoundCopy {
  allPosts: string
  description: string
  footerRole: string
  githubLabel: string
  goHome: string
  linkedinLabel: string
  maybeLookingFor: string
  quickLinks404: string
  rssFeed: string
  status: string
  terminalContentType: string
  terminalLabel404: string
  terminalServer: string
  terminalTitle: string
  title: string
  tracePrefix: string
  viewBlog: string
}

interface Props {
  blogPath: string
  copy: NotFoundCopy
  homePath: string
  lang: Language
  tracePath: string
}

const { blogPath, copy, homePath, lang, tracePath } = Astro.props
const quickLinks = [
  { href: blogPath, label: copy.allPosts },
  { href: SITE.social.github, label: copy.githubLabel, external: true },
  { href: SITE.social.linkedin, label: copy.linkedinLabel, external: true },
  { href: '/rss.xml', label: copy.rssFeed },
]
---

<section class="approved-not-found relative isolate overflow-hidden border-b border-border">
  <div class="approved-not-found__landscape pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="approved-not-found__wash pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container grid min-h-[calc(100svh-4.5rem)] items-center gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_minmax(19rem,0.42fr)] lg:gap-16 lg:py-20">
    <div class="max-w-4xl">
      <div class="mb-5 flex items-center gap-3">
        <span class="bg-primary h-px w-8"></span>
        <span class="editorial-kicker">{lang.toUpperCase()} · NOT FOUND</span>
      </div>

      <p class="editorial-display text-primary text-[clamp(5.5rem,15vw,11rem)] leading-[0.72] font-semibold tracking-[-0.085em]" aria-hidden="true">
        404
      </p>
      <h1 class="editorial-display mt-7 max-w-3xl text-[clamp(2.7rem,5.6vw,5.25rem)] leading-[0.96] font-semibold tracking-[-0.055em]">
        {copy.title}
      </h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-base leading-7 sm:text-lg sm:leading-8">
        {copy.description}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={homePath} class="btn btn-primary min-h-11 px-5">
          {copy.goHome}
          <span aria-hidden="true">→</span>
        </a>
        <a href={blogPath} class="btn btn-outline min-h-11 px-5">
          {copy.viewBlog}
        </a>
      </div>
    </div>

    <aside class="border-border bg-background/72 border p-5 backdrop-blur-sm sm:p-6" aria-label={copy.quickLinks404}>
      <p class="editorial-kicker">{copy.maybeLookingFor}</p>
      <nav class="mt-5">
        <ul class="divide-border divide-y border-y border-border">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group text-foreground hover:text-primary flex min-h-12 items-center justify-between gap-4 py-3 text-sm transition-colors"
                  {...(link.external && { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  <span>{link.label}</span>
                  <span class="text-muted-foreground transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="text-muted-foreground mt-5 font-mono text-[0.58rem] leading-5 break-all tracking-[0.08em] uppercase">
        {copy.tracePrefix}<span>{tracePath}</span>
      </p>
    </aside>
  </div>
</section>

<style>
  .approved-not-found {
    background: var(--editorial-paper);
  }

  .approved-not-found__wash {
    background:
      linear-gradient(90deg, color-mix(in oklch, var(--background) 96%, transparent) 0 45%, color-mix(in oklch, var(--background) 64%, transparent) 78%, transparent),
      linear-gradient(0deg, color-mix(in oklch, var(--background) 82%, transparent), transparent 56%);
  }

  .approved-not-found__landscape {
    inset: auto -7% -8% 32%;
    height: 76%;
    opacity: 0.26;
    background:
      radial-gradient(ellipse at 20% 76%, color-mix(in oklch, var(--foreground) 19%, transparent) 0 18%, transparent 19%),
      radial-gradient(ellipse at 48% 82%, color-mix(in oklch, var(--foreground) 14%, transparent) 0 25%, transparent 26%),
      radial-gradient(ellipse at 78% 72%, color-mix(in oklch, var(--primary) 15%, transparent) 0 20%, transparent 21%);
    clip-path: polygon(0 68%, 12% 48%, 24% 58%, 38% 25%, 54% 60%, 66% 40%, 82% 64%, 100% 34%, 100% 100%, 0 100%);
  }

  .dark .approved-not-found__landscape {
    opacity: 0.38;
  }
</style>
