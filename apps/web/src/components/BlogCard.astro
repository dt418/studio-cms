---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import TagsList from './Blog/TagsList.astro'
import { formatDate } from '@/lib/date'
import { getOptimizedCoverImage } from '@/lib/cover-images'
import { getPostPath } from '@/lib/routes'
import { getPostLocale } from '@/lib/content-utils'

interface Props {
  post: CollectionEntry<'posts'>
}

const { post } = Astro.props
const { title, excerpt, coverImage, publishedAt, tags, category } = post.data
const formattedDate = formatDate(publishedAt, getPostLocale(post))
const postPath = getPostPath(post)
const optimizedCoverImage = coverImage ? getOptimizedCoverImage(coverImage) : undefined
---

<article class="editorial-card group flex h-full flex-col overflow-hidden rounded-lg">
  <a href={postPath} class="flex min-h-11 flex-1 flex-col" aria-label={title}>
    {
      coverImage && (
        <div class="bg-muted aspect-[16/10] overflow-hidden">
          {optimizedCoverImage ? (
            <Image
              src={optimizedCoverImage}
              alt={title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
              sizes="(max-width: 768px) calc(100vw - 2rem), 400px"
              width="640"
              height="400"
              layout="constrained"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              src={coverImage}
              alt={title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
              sizes="(max-width: 768px) calc(100vw - 2rem), 400px"
              width="640"
              height="400"
              layout="constrained"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      )
    }

    <div class="flex flex-1 flex-col p-5 pb-3 sm:p-6 sm:pb-3">
      <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="editorial-kicker">{category}</span>
        <span class="bg-border h-px w-6" aria-hidden="true"></span>
        <time class="text-muted-foreground font-mono text-[0.66rem] tracking-[0.12em] uppercase">
          {formattedDate}
        </time>
      </div>

      <h2 class="editorial-display text-foreground text-2xl leading-[1.08] font-semibold tracking-[-0.035em] text-pretty sm:text-[1.7rem]">
        {title}
      </h2>
      <p class="text-muted-foreground mt-3 line-clamp-3 text-sm leading-7 text-pretty">
        {excerpt}
      </p>
    </div>
  </a>

  <div class="px-5 pb-5 sm:px-6 sm:pb-6">
    <TagsList tags={tags} post={post} />
  </div>
</article>
