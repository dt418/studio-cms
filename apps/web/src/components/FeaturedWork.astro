---
import type { Post } from '@/lib/content-queries'
import { formatDate } from '@/lib/date'
import { getPostPath } from '@/lib/routes'
import { readingTime } from '@/lib/reading-time'
import { getFeaturedMark } from '@/lib/featured-work'

interface Props {
  featuredPost: Post | null
  recentPosts: Post[]
  lang?: 'vi' | 'en'
  i18n?: {
    featured: string
    latestFromBlog: string
    recentDescription: string
    readMore: string
    recentLabel: string
    featuredIndex: string
    notesLabel: string
    minRead: string
  }
}

const {
  featuredPost = null,
  recentPosts,
  lang = 'vi',
  i18n = {
    featured: 'Featured',
    latestFromBlog: 'Latest from the blog.',
    recentDescription: 'Recent tutorials, guides, and notes on web development.',
    readMore: 'Read more',
    recentLabel: 'Recently published',
    featuredIndex: 'featured / 01',
    notesLabel: 'notes',
    minRead: 'min read',
  },
} = Astro.props

const featuredPath = featuredPost ? getPostPath(featuredPost) : '#'
const featuredReadingTime =
  featuredPost?.data.readingTime ??
  (featuredPost?.body !== undefined ? readingTime(featuredPost.body) : undefined)
const featuredMark = featuredPost ? getFeaturedMark(featuredPost.data.title) : ''
const featuredMarkLabel = featuredPost?.data.category ?? ''
---

<section class="border-border border-b">
  <div class="container py-14 lg:py-20">
    <div
      class="border-border mb-8 flex flex-col gap-3 border-b pb-5 sm:flex-row sm:items-end sm:justify-between"
    >
      <div class="max-w-3xl">
        <p class="text-primary font-mono text-[0.66rem] tracking-[0.18em] uppercase">
          {i18n.featured}
        </p>
        <h2 class="mt-3 max-w-2xl font-serif text-3xl font-bold tracking-tight lg:text-4xl">
          {i18n.latestFromBlog}
        </h2>
        <p class="text-muted-foreground mt-3 max-w-2xl text-base leading-7 sm:text-lg">
          {i18n.recentDescription}
        </p>
      </div>
    </div>

    {
      featuredPost && (
        <a
          href={featuredPath}
          data-testid="featured-work"
          class="group border-border bg-card/30 hover:border-primary relative mb-14 block overflow-hidden rounded-xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
        >
          <span class="bg-primary absolute inset-y-0 left-0 w-1 origin-bottom scale-y-0 transition-transform duration-500 group-hover:scale-y-100" />
          <div class="grid items-stretch lg:grid-cols-[minmax(0,1.4fr)_minmax(260px,0.6fr)]">
            <div class="p-6 sm:p-10 lg:p-12">
              <div class="mb-5 flex flex-wrap items-center gap-3">
                <span
                  data-testid="featured-category"
                  class="bg-accent text-accent-foreground rounded px-2.5 py-1 font-mono text-[0.62rem] font-bold tracking-[0.16em] uppercase"
                >
                  {featuredPost.data.category}
                </span>
                <time class="text-muted-foreground font-mono text-[0.66rem] tracking-[0.18em] uppercase">
                  {formatDate(featuredPost.data.publishedAt, lang)}
                </time>
                {
                  featuredReadingTime !== undefined && (
                    <span
                      data-testid="featured-reading-time"
                      class="text-muted-foreground/50 font-mono text-[0.66rem] tracking-[0.16em] uppercase"
                    >
                      {featuredReadingTime} {i18n.minRead}
                    </span>
                  )
                }
              </div>

              <h3 class="text-foreground group-hover:text-primary max-w-3xl font-serif text-3xl leading-[1.08] font-bold tracking-tight transition-colors sm:text-4xl lg:text-5xl">
                {featuredPost.data.title}
              </h3>
              <p class="text-muted-foreground mt-5 max-w-2xl text-sm leading-7 sm:text-base">
                {featuredPost.data.excerpt}
              </p>

              <div class="text-primary mt-8 flex items-center gap-2 font-mono text-[0.66rem] font-semibold tracking-[0.18em] uppercase">
                <span>{i18n.readMore}</span>
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">
                  →
                </span>
              </div>
            </div>

            <div class="border-border bg-background/70 flex min-h-64 flex-col items-center justify-center border-t p-8 lg:border-t-0 lg:border-l">
              <span
                data-testid="featured-mark"
                class="text-primary font-serif text-8xl leading-none font-bold tracking-[-0.08em] transition-transform duration-500 group-hover:scale-105"
              >
                {featuredMark}
              </span>
              <span
                data-testid="featured-mark-label"
                class="text-muted-foreground mt-3 font-mono text-[0.62rem] tracking-[0.2em] uppercase"
              >
                {featuredMarkLabel}
              </span>
              <span class="border-primary/40 text-primary mt-7 border px-3 py-1 font-mono text-[0.58rem] tracking-[0.2em] uppercase">
                {i18n.featuredIndex}
              </span>
            </div>
          </div>
        </a>
      )
    }

    {
      recentPosts.length > 0 && (
        <div>
          <div class="mb-5 flex items-center justify-between gap-4">
            <p class="text-primary font-mono text-[0.66rem] tracking-[0.18em] uppercase">
              {i18n.recentLabel}
            </p>
            <span class="text-muted-foreground font-mono text-[0.62rem] tracking-[0.16em] uppercase">
              {recentPosts.length.toString().padStart(2, '0')} {i18n.notesLabel}
            </span>
          </div>
          <div class="border-border divide-border divide-y border-y">
            {recentPosts.map((post, index) => (
              <a
                href={getPostPath(post)}
                class="group hover:bg-card/40 relative grid gap-4 px-3 py-6 transition-colors sm:grid-cols-[48px_minmax(0,1fr)_auto] sm:items-center sm:px-4"
              >
                <span class="text-muted-foreground/50 font-mono text-[0.68rem] tracking-[0.16em] tabular-nums">
                  {String(index + 2).padStart(2, '0')}
                </span>
                <span class="min-w-0">
                  <span class="mb-2 flex flex-wrap items-center gap-3">
                    <span class="text-primary font-mono text-[0.62rem] tracking-[0.16em] uppercase">
                      {post.data.category}
                    </span>
                    <time class="text-muted-foreground/60 font-mono text-[0.62rem] tracking-[0.16em] uppercase">
                      {formatDate(post.data.publishedAt, lang)}
                    </time>
                  </span>
                  <span class="text-foreground group-hover:text-primary block truncate font-serif text-xl font-bold tracking-tight transition-colors sm:text-2xl">
                    {post.data.title}
                  </span>
                  <span class="text-muted-foreground mt-2 line-clamp-1 block text-sm">
                    {post.data.excerpt}
                  </span>
                </span>
                <span class="text-primary font-mono text-[0.62rem] tracking-[0.16em] uppercase transition-transform duration-300 group-hover:translate-x-1">
                  →
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
