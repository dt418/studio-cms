---
import { Image } from 'astro:assets'
import type { Post } from '@/lib/content-queries'
import { formatDate } from '@/lib/date'
import { getPostPath } from '@/lib/routes'
import { readingTime } from '@/lib/reading-time'
import { getFeaturedMark } from '@/lib/featured-work'
import { getOptimizedCoverImage } from '@/lib/cover-images'

interface Props {
  featuredPost: Post | null
  recentPosts: Post[]
  lang?: 'vi' | 'en'
  i18n?: {
    featured: string
    latestFromBlog: string
    recentDescription: string
    readMore: string
    recentLabel: string
    featuredIndex: string
    notesLabel: string
    minRead: string
  }
}

const {
  featuredPost = null,
  recentPosts,
  lang = 'vi',
  i18n = {
    featured: 'Featured',
    latestFromBlog: 'Latest from the blog.',
    recentDescription: 'Recent tutorials, guides, and notes on web development.',
    readMore: 'Read more',
    recentLabel: 'Recently published',
    featuredIndex: 'featured / 01',
    notesLabel: 'notes',
    minRead: 'min read',
  },
} = Astro.props

const featuredPath = featuredPost ? getPostPath(featuredPost) : '#'
const featuredReadingTime =
  featuredPost?.data.readingTime ??
  (featuredPost?.body !== undefined ? readingTime(featuredPost.body) : undefined)
const featuredMark = featuredPost ? getFeaturedMark(featuredPost.data.title) : ''
const featuredMarkLabel = featuredPost?.data.category ?? ''
const featuredCover = featuredPost?.data.coverImage
const optimizedFeaturedCover = featuredCover ? getOptimizedCoverImage(featuredCover) : undefined
---

<section class="border-border border-b">
  <div class="container py-16 sm:py-20 lg:py-28">
    <div class="mb-10 grid gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(280px,0.45fr)] lg:items-end">
      <div class="max-w-3xl">
        <div class="mb-4 flex items-center gap-3">
          <span class="bg-primary h-px w-10"></span>
          <p class="editorial-kicker">{i18n.featured}</p>
        </div>
        <h2 class="editorial-display max-w-3xl text-4xl leading-[0.98] font-semibold tracking-[-0.045em] sm:text-5xl lg:text-6xl">
          {i18n.latestFromBlog}
        </h2>
        <p class="text-muted-foreground mt-4 max-w-2xl text-base leading-8 sm:text-lg">
          {i18n.recentDescription}
        </p>
      </div>
      <div class="hidden justify-self-end lg:block" aria-hidden="true">
        <div class="h-px w-40 bg-border"></div>
      </div>
    </div>

    {
      featuredPost && (
        <a
          href={featuredPath}
          data-testid="featured-work"
          class="group editorial-surface relative mb-14 block overflow-hidden rounded-[1.6rem] transition-transform duration-300 hover:-translate-y-1"
        >
          <div class="grid min-h-[30rem] lg:grid-cols-[minmax(0,1.05fr)_minmax(340px,0.95fr)]">
            <div class="flex flex-col justify-between p-6 sm:p-10 lg:p-12">
              <div>
                <div class="mb-6 flex flex-wrap items-center gap-3">
                  <span data-testid="featured-category" class="editorial-kicker">
                    {featuredPost.data.category}
                  </span>
                  <span class="bg-border h-px w-8" aria-hidden="true" />
                  <time class="text-muted-foreground font-mono text-[0.66rem] tracking-[0.14em] uppercase">
                    {formatDate(featuredPost.data.publishedAt, lang)}
                  </time>
                  {featuredReadingTime !== undefined && (
                    <span
                      data-testid="featured-reading-time"
                      class="text-muted-foreground/70 font-mono text-[0.66rem] tracking-[0.14em] uppercase"
                    >
                      {featuredReadingTime} {i18n.minRead}
                    </span>
                  )}
                </div>

                <h3 class="editorial-display text-foreground group-hover:text-primary max-w-3xl text-4xl leading-[0.98] font-semibold tracking-[-0.045em] transition-colors sm:text-5xl lg:text-6xl">
                  {featuredPost.data.title}
                </h3>
                <p class="text-muted-foreground mt-6 max-w-2xl text-base leading-8">
                  {featuredPost.data.excerpt}
                </p>
              </div>

              <div class="text-primary mt-10 flex items-center gap-2 font-mono text-[0.68rem] font-semibold tracking-[0.16em] uppercase">
                <span>{i18n.readMore}</span>
                <span class="inline-block transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
                  →
                </span>
              </div>
            </div>

            <div class="border-border relative min-h-72 overflow-hidden border-t lg:border-t-0 lg:border-l">
              {featuredCover ? (
                optimizedFeaturedCover ? (
                  <Image
                    src={optimizedFeaturedCover}
                    alt={featuredPost.data.title}
                    width="960"
                    height="720"
                    layout="constrained"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
                    sizes="(max-width: 1024px) 100vw, 45vw"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <Image
                    src={featuredCover}
                    alt={featuredPost.data.title}
                    width="960"
                    height="720"
                    layout="constrained"
                    class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.035]"
                    sizes="(max-width: 1024px) 100vw, 45vw"
                    loading="lazy"
                    decoding="async"
                  />
                )
              ) : (
                <div class="cinematic-panel cinematic-panel-grid flex h-full min-h-72 items-center justify-center p-8">
                  <span
                    data-testid="featured-mark"
                    class="editorial-display text-primary text-8xl leading-none font-semibold tracking-[-0.08em]"
                  >
                    {featuredMark}
                  </span>
                </div>
              )}

              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-6 pt-20 text-white">
                <span
                  data-testid="featured-mark"
                  class="editorial-display text-4xl leading-none font-semibold tracking-[-0.06em]"
                >
                  {featuredMark}
                </span>
                <div class="mt-3 flex items-center justify-between gap-4">
                  <span data-testid="featured-mark-label" class="font-mono text-[0.62rem] tracking-[0.18em] text-white/75 uppercase">
                    {featuredMarkLabel}
                  </span>
                  <span class="border border-white/25 px-2 py-1 font-mono text-[0.58rem] tracking-[0.16em] text-white/75 uppercase">
                    {i18n.featuredIndex}
                  </span>
                </div>
              </div>
            </div>
          </div>
        </a>
      )
    }

    {
      recentPosts.length > 0 && (
        <div>
          <div class="mb-5 flex items-center justify-between gap-4">
            <p class="editorial-kicker">{i18n.recentLabel}</p>
            <span class="text-muted-foreground font-mono text-[0.62rem] tracking-[0.16em] uppercase">
              {recentPosts.length.toString().padStart(2, '0')} {i18n.notesLabel}
            </span>
          </div>
          <div class="border-border divide-border divide-y border-y">
            {recentPosts.map((post, index) => (
              <a
                href={getPostPath(post)}
                class="group hover:bg-card/40 relative grid gap-4 px-2 py-7 transition-colors sm:grid-cols-[48px_minmax(0,1fr)_auto] sm:items-center sm:px-4"
              >
                <span class="text-muted-foreground/50 font-mono text-[0.68rem] tracking-[0.16em] tabular-nums">
                  {String(index + 2).padStart(2, '0')}
                </span>
                <span class="min-w-0">
                  <span class="mb-2 flex flex-wrap items-center gap-3">
                    <span class="editorial-kicker">{post.data.category}</span>
                    <time class="text-muted-foreground/70 font-mono text-[0.62rem] tracking-[0.12em] uppercase">
                      {formatDate(post.data.publishedAt, lang)}
                    </time>
                  </span>
                  <span class="editorial-display text-foreground group-hover:text-primary block max-w-4xl text-2xl leading-tight font-semibold tracking-[-0.025em] text-pretty transition-colors sm:text-3xl">
                    {post.data.title}
                  </span>
                  <span class="text-muted-foreground mt-2 line-clamp-2 block max-w-3xl text-sm leading-6">
                    {post.data.excerpt}
                  </span>
                </span>
                <span class="text-primary font-mono text-[0.62rem] tracking-[0.16em] uppercase transition-transform duration-300 group-hover:translate-x-1">
                  →
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
