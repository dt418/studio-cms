---
import { Image } from 'astro:assets'
import type { Post } from '@/lib/content-queries'
import { formatDate } from '@/lib/date'
import { getPostPath } from '@/lib/routes'
import { readingTime } from '@/lib/reading-time'
import { getFeaturedMark } from '@/lib/featured-work'
import { getOptimizedCoverImage } from '@/lib/cover-images'

interface Props {
  featuredPost: Post | null
  recentPosts: Post[]
  lang?: 'vi' | 'en'
  i18n?: {
    featured: string
    latestFromBlog: string
    recentDescription: string
    readMore: string
    recentLabel: string
    featuredIndex: string
    notesLabel: string
    minRead: string
  }
}

const {
  featuredPost = null,
  recentPosts,
  lang = 'vi',
  i18n = {
    featured: 'Featured',
    latestFromBlog: 'Latest from the blog.',
    recentDescription: 'Recent tutorials, guides, and notes on web development.',
    readMore: 'Read more',
    recentLabel: 'Recently published',
    featuredIndex: 'featured / 01',
    notesLabel: 'notes',
    minRead: 'min read',
  },
} = Astro.props

const featuredPath = featuredPost ? getPostPath(featuredPost) : '#'
const featuredReadingTime =
  featuredPost?.data.readingTime ??
  (featuredPost?.body !== undefined ? readingTime(featuredPost.body) : undefined)
const featuredMark = featuredPost ? getFeaturedMark(featuredPost.data.title) : ''
const featuredMarkLabel = featuredPost?.data.category ?? ''
const featuredCover = featuredPost?.data.coverImage
const optimizedFeaturedCover = featuredCover ? getOptimizedCoverImage(featuredCover) : undefined
const sectionTitle = lang === 'vi' ? 'Bài viết nổi bật' : 'Featured writing'
const sectionDescription =
  lang === 'vi'
    ? 'Những bài viết tâm đắc và hữu ích nhất, được chọn lọc kỹ càng.'
    : 'A considered selection of practical writing worth starting with.'
const allPostsLabel = lang === 'vi' ? 'Xem tất cả bài viết' : 'View all writing'
---

<section class="approved-featured border-border border-b bg-background">
  <div class="container py-11 sm:py-14 lg:py-16">
    <div class="mb-6 flex items-end justify-between gap-5 border-b border-border pb-4 sm:mb-7">
      <div>
        <h2 class="editorial-display text-3xl leading-none font-semibold tracking-[-0.035em] sm:text-4xl">
          {sectionTitle}
        </h2>
        <p class="text-muted-foreground mt-2 text-sm leading-6 sm:text-base">{sectionDescription}</p>
      </div>
      <a href={`/${lang}/blog/`} class="site-footer-link hidden sm:inline-flex">
        {allPostsLabel} <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      featuredPost && (
        <div class="grid gap-4 lg:grid-cols-[minmax(0,1.18fr)_minmax(22rem,0.82fr)] lg:gap-5">
          <a
            href={featuredPath}
            data-testid="featured-work"
            class="approved-feature-card group relative min-h-[27rem] overflow-hidden border border-border bg-card sm:min-h-[31rem] lg:min-h-[35rem]"
          >
            {featuredCover ? (
              optimizedFeaturedCover ? (
                <Image
                  src={optimizedFeaturedCover}
                  alt={featuredPost.data.title}
                  width="1200"
                  height="900"
                  layout="constrained"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
                  sizes="(max-width: 1024px) 100vw, 58vw"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <Image
                  src={featuredCover}
                  alt={featuredPost.data.title}
                  width="1200"
                  height="900"
                  layout="constrained"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
                  sizes="(max-width: 1024px) 100vw, 58vw"
                  loading="lazy"
                  decoding="async"
                />
              )
            ) : (
              <div class="approved-card-fallback absolute inset-0" aria-hidden="true" />
            )}

            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/38 to-black/10" aria-hidden="true"></div>

            <div class="relative z-10 flex min-h-[inherit] flex-col justify-between p-5 text-white sm:p-7 lg:p-8">
              <div class="flex items-start justify-between gap-4">
                <span class="bg-primary px-2.5 py-1 font-mono text-[0.58rem] font-semibold tracking-[0.14em] text-white uppercase">
                  {i18n.featured}
                </span>
                <span data-testid="featured-mark" class="editorial-display text-2xl font-semibold text-white/80">
                  {featuredMark}
                </span>
              </div>

              <div class="max-w-[42rem]">
                <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.6rem] tracking-[0.1em] text-white/70 uppercase">
                  <time>{formatDate(featuredPost.data.publishedAt, lang)}</time>
                  <span aria-hidden="true">·</span>
                  <span data-testid="featured-category">{featuredPost.data.category}</span>
                  {featuredReadingTime !== undefined && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span data-testid="featured-reading-time">
                        {featuredReadingTime} {i18n.minRead}
                      </span>
                    </>
                  )}
                </div>
                <h3 class="editorial-display text-[clamp(2rem,4vw,3.8rem)] leading-[0.98] font-semibold tracking-[-0.045em] text-white">
                  {featuredPost.data.title}
                </h3>
                <p class="mt-4 line-clamp-3 max-w-2xl text-sm leading-6 text-white/76 sm:text-base sm:leading-7">
                  {featuredPost.data.excerpt}
                </p>
                <div class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#ff8a67]">
                  {i18n.readMore} <span aria-hidden="true">→</span>
                </div>
                <span data-testid="featured-mark-label" class="sr-only">{featuredMarkLabel}</span>
              </div>
            </div>
          </a>

          <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
            {recentPosts.map((post, index) => {
              const cover = post.data.coverImage
              const optimizedCover = cover ? getOptimizedCoverImage(cover) : undefined
              const postReadingTime =
                post.data.readingTime ?? (post.body !== undefined ? readingTime(post.body) : undefined)

              return (
                <a
                  href={getPostPath(post)}
                  class="approved-supporting-card group grid min-h-[9.25rem] grid-cols-[8.5rem_minmax(0,1fr)] overflow-hidden border border-border bg-card transition-colors hover:border-primary/45 sm:grid-cols-1 lg:grid-cols-[10rem_minmax(0,1fr)]"
                >
                  <div class="relative min-h-[8.25rem] overflow-hidden bg-muted sm:min-h-32 lg:min-h-full">
                    {cover ? (
                      optimizedCover ? (
                        <Image
                          src={optimizedCover}
                          alt=""
                          width="420"
                          height="300"
                          layout="constrained"
                          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.035]"
                          sizes="(max-width: 640px) 35vw, (max-width: 1024px) 30vw, 12vw"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <Image
                          src={cover}
                          alt=""
                          width="420"
                          height="300"
                          layout="constrained"
                          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.035]"
                          sizes="(max-width: 640px) 35vw, (max-width: 1024px) 30vw, 12vw"
                          loading="lazy"
                          decoding="async"
                        />
                      )
                    ) : (
                      <div class="approved-card-fallback absolute inset-0" aria-hidden="true" />
                    )}
                  </div>
                  <div class="flex min-w-0 flex-col justify-between p-4 sm:p-4 lg:p-5">
                    <div>
                      <div class="mb-2 flex items-center justify-between gap-3">
                        <span class="editorial-kicker">{post.data.category}</span>
                        <span class="text-muted-foreground/55 font-mono text-[0.58rem] tabular-nums">
                          {String(index + 2).padStart(2, '0')}
                        </span>
                      </div>
                      <h3 class="editorial-display text-foreground group-hover:text-primary line-clamp-3 text-xl leading-[1.08] font-semibold tracking-[-0.025em] transition-colors">
                        {post.data.title}
                      </h3>
                    </div>
                    <div class="text-muted-foreground mt-4 flex flex-wrap gap-x-2 text-[0.66rem]">
                      <time>{formatDate(post.data.publishedAt, lang)}</time>
                      {postReadingTime !== undefined && <span>· {postReadingTime} {i18n.minRead}</span>}
                    </div>
                  </div>
                </a>
              )
            })}
          </div>
        </div>
      )
    }

    <div class="mt-6 sm:hidden">
      <a href={`/${lang}/blog/`} class="site-footer-link inline-flex">
        {allPostsLabel} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
