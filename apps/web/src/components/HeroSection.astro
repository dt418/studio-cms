---
import type { Translations } from '@/lib/i18n'
import { getAboutPath, getBlogPath } from '@/lib/routes'

export interface Props {
  posts: number
  categories: number
  allTags: number
  i18n: Translations['hero']
  lang?: 'vi' | 'en'
  heroImage?: string
}

const { posts, categories, allTags, i18n, lang = 'vi', heroImage } = Astro.props
const blogPath = getBlogPath(lang)
const aboutPath = getAboutPath(lang)

const copy =
  lang === 'vi'
    ? {
        eyebrow: 'DEV · IDEAS · A BRIGHTER INTERNET',
        lineOne: 'Xây sản phẩm tốt hơn.',
        lineTwo: 'Chia sẻ điều học được.',
        about: 'Về tôi',
        postLabel: 'Bài viết',
        topicLabel: 'Chủ đề',
        tagLabel: 'Thẻ',
        note: 'Những người phần mềm bắt đầu từ những người sẵn sàng học hỏi.',
      }
    : {
        eyebrow: 'DEV · IDEAS · A BRIGHTER INTERNET',
        lineOne: 'Build better products.',
        lineTwo: 'Share what you learn.',
        about: 'About me',
        postLabel: 'Posts',
        topicLabel: 'Topics',
        tagLabel: 'Tags',
        note: 'Better software starts with people willing to keep learning.',
      }
---

<section class="approved-cinematic-hero relative isolate overflow-hidden border-b border-white/15 bg-[#1c211f] text-white">
  {
    heroImage ? (
      <img
        src={heroImage}
        alt=""
        aria-hidden="true"
        class="approved-cinematic-hero__image absolute inset-0 h-full w-full object-cover"
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    ) : (
      <div class="approved-cinematic-hero__fallback absolute inset-0" aria-hidden="true" />
    )
  }
  <div class="approved-cinematic-hero__veil absolute inset-0" aria-hidden="true"></div>

  <div class="container relative z-10 flex min-h-[clamp(34rem,72vh,46rem)] flex-col justify-between py-10 sm:py-14 lg:py-16">
    <div class="max-w-[56rem] pt-6 sm:pt-10 lg:pt-14">
      <div class="mb-5 flex items-center gap-3 sm:mb-7">
        <span class="h-px w-8 bg-[#ff744a] sm:w-10"></span>
        <p class="font-mono text-[0.62rem] font-semibold tracking-[0.2em] text-white/75 uppercase sm:text-[0.68rem]">
          {copy.eyebrow}
        </p>
      </div>

      <h1 class="editorial-display max-w-[54rem] text-[clamp(3.35rem,6.5vw,6.65rem)] leading-[0.91] font-semibold tracking-[-0.065em] text-white text-shadow-sm">
        <span class="block">{copy.lineOne}</span>
        <span class="block">{copy.lineTwo}</span>
      </h1>

      <p class="mt-6 max-w-[39rem] text-[0.98rem] leading-7 text-white/82 sm:mt-7 sm:text-lg sm:leading-8">
        {i18n.description}
      </p>

      <div data-testid="hero-cta" class="mt-8 flex flex-wrap gap-3 sm:mt-9">
        <a href={blogPath} class="approved-hero-btn approved-hero-btn--primary">
          {i18n.cta.readBlog}
          <span aria-hidden="true">→</span>
        </a>
        <a href={aboutPath} class="approved-hero-btn approved-hero-btn--secondary">
          {copy.about}
        </a>
      </div>
    </div>

    <div class="mt-12 grid gap-5 border-t border-white/22 pt-5 sm:grid-cols-[auto_auto_auto_1fr] sm:items-end sm:gap-8 lg:mt-16 lg:pt-6">
      <div data-testid="hero-stats" class="contents">
        <div class="min-w-20">
          <p class="editorial-display text-2xl leading-none font-semibold sm:text-3xl">{posts}+</p>
          <p class="mt-1.5 font-mono text-[0.58rem] tracking-[0.14em] text-white/62 uppercase">{copy.postLabel}</p>
        </div>
        <div class="min-w-20">
          <p class="editorial-display text-2xl leading-none font-semibold sm:text-3xl">{categories}+</p>
          <p class="mt-1.5 font-mono text-[0.58rem] tracking-[0.14em] text-white/62 uppercase">{copy.topicLabel}</p>
        </div>
        <div class="min-w-20">
          <p class="editorial-display text-2xl leading-none font-semibold sm:text-3xl">{allTags}+</p>
          <p class="mt-1.5 font-mono text-[0.58rem] tracking-[0.14em] text-white/62 uppercase">{copy.tagLabel}</p>
        </div>
      </div>

      <p class="hidden max-w-sm justify-self-end text-right text-sm leading-6 text-white/68 sm:block">
        “{copy.note}”
      </p>
    </div>
  </div>
</section>
