---
import type { Post } from '@/lib/content-graph'
import { getTranslations } from '@/lib/i18n'
import { formatDate } from '@/lib/date'
import { getPostPath } from '@/lib/routes'

interface Props {
  posts: Post[]
  lang?: 'vi' | 'en'
}

const { posts, lang = 'vi' } = Astro.props
const i18n = getTranslations(lang)
const labels = i18n.archive
const archivePath = lang === 'en' ? '/en/blog' : '/vi/blog'
---

<section class="border-border border-b">
  <div class="container py-14 lg:py-20">
    <div
      class="border-border mb-8 flex flex-col gap-4 border-b pb-5 lg:flex-row lg:items-end lg:justify-between"
    >
      <div class="max-w-2xl">
        <p class="text-primary font-mono text-[0.66rem] tracking-[0.18em] uppercase">
          {labels.browse}
        </p>
        <h2 class="mt-3 max-w-2xl font-serif text-3xl font-bold tracking-tight lg:text-4xl">
          {labels.allPosts}
        </h2>
        <p class="text-muted-foreground mt-3 max-w-2xl text-base leading-7 sm:text-lg">
          {labels.fullArchive}
        </p>
      </div>
      <a
        href={archivePath}
        class="group text-muted-foreground hover:text-primary inline-flex items-center gap-2 font-mono text-[0.66rem] tracking-[0.18em] uppercase transition-colors"
      >
        <span>{labels.openFullArchive}</span>
        <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-muted-foreground mt-8 text-sm">{labels.noArchivedPosts}</p>
      ) : (
        <div class="border-border divide-border divide-y overflow-hidden rounded-xl border">
          {posts.map((post, index) => (
            <a
              href={getPostPath(post)}
              class="group hover:bg-card/40 relative grid gap-4 px-4 py-6 transition-colors duration-300 sm:grid-cols-[52px_132px_minmax(0,1fr)_auto] sm:items-center sm:px-6"
            >
              <span class="bg-primary absolute inset-y-0 left-0 w-1 origin-bottom scale-y-0 transition-transform duration-500 group-hover:scale-y-100" />
              <span class="text-muted-foreground/50 font-mono text-[0.68rem] tracking-[0.16em] tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <time
                datetime={post.data.publishedAt.toISOString()}
                class="text-muted-foreground font-mono text-[0.66rem] tracking-[0.16em] uppercase tabular-nums"
              >
                {formatDate(post.data.publishedAt, lang)}
              </time>
              <span class="min-w-0">
                <span class="text-primary mb-2 block font-mono text-[0.62rem] tracking-[0.16em] uppercase">
                  {post.data.category}
                </span>
                <span class="text-foreground group-hover:text-primary block truncate font-serif text-xl font-bold tracking-tight transition-colors sm:text-2xl">
                  {post.data.title}
                </span>
                <span class="text-muted-foreground mt-2 line-clamp-1 block text-sm">
                  {post.data.excerpt}
                </span>
              </span>
              <span class="text-primary font-mono text-[0.62rem] tracking-[0.16em] uppercase transition-transform duration-300 group-hover:translate-x-1">
                →
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
