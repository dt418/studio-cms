---
import type { Post } from '@/lib/content-graph'
import { getTranslations } from '@/lib/i18n'
import { formatDate } from '@/lib/date'
import { getBlogPath, getPostPath } from '@/lib/routes'

interface Props {
  posts: Post[]
  lang?: 'vi' | 'en'
}

const { posts, lang = 'vi' } = Astro.props
const i18n = getTranslations(lang)
const labels = i18n.archive
const archivePath = getBlogPath(lang)
---

<section class="border-border border-b bg-background">
  <div class="container py-11 sm:py-14 lg:py-16">
    <div class="border-border mb-7 flex flex-col gap-4 border-b pb-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="editorial-kicker">{labels.browse}</p>
        <h2 class="editorial-display mt-3 max-w-2xl text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl">
          {labels.allPosts}
        </h2>
        <p class="text-muted-foreground mt-2 max-w-2xl text-sm leading-6 sm:text-base sm:leading-7">
          {labels.fullArchive}
        </p>
      </div>
      <a href={archivePath} class="site-footer-link">
        <span>{labels.openFullArchive}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-muted-foreground mt-8 text-sm">{labels.noArchivedPosts}</p>
      ) : (
        <div class="border-border divide-border divide-y border-y">
          {posts.map((post, index) => (
            <a
              href={getPostPath(post)}
              class="group hover:bg-card/35 grid gap-3 px-1 py-5 transition-colors sm:grid-cols-[42px_120px_minmax(0,1fr)_auto] sm:items-center sm:gap-5 sm:px-2"
            >
              <span class="text-muted-foreground/45 font-mono text-[0.62rem] tracking-[0.14em] tabular-nums">
                {String(index + 1).padStart(2, '0')}
              </span>
              <time
                datetime={post.data.publishedAt.toISOString()}
                class="text-muted-foreground font-mono text-[0.62rem] tracking-[0.1em] uppercase tabular-nums"
              >
                {formatDate(post.data.publishedAt, lang)}
              </time>
              <span class="min-w-0">
                <span class="text-primary mb-1.5 block font-mono text-[0.58rem] tracking-[0.13em] uppercase">
                  {post.data.category}
                </span>
                <span class="editorial-display text-foreground group-hover:text-primary block text-xl leading-tight font-semibold tracking-[-0.025em] text-pretty transition-colors sm:text-2xl">
                  {post.data.title}
                </span>
              </span>
              <span class="text-primary font-mono text-[0.62rem] tracking-[0.14em] transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
                →
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>
