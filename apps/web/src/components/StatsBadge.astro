---
interface Props {
  label: string
  value: number
}

const { label, value } = Astro.props
---

<span class="border-border bg-card/40 inline-flex items-center gap-2 rounded border px-3 py-1.5">
  <span class="text-primary font-mono font-bold tabular-nums">{value}</span>
  <span class="text-muted-foreground">{label}</span>
</span>
