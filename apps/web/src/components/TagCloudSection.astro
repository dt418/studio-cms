---
import { getBlogPath } from '@/lib/routes'
import type { SupportedLocale } from '@/lib/content-utils'

export interface Props {
  tags: Array<{ name: string; count: number }>
  lang: SupportedLocale
  title: string
  linkText: string
}

const { tags, lang, linkText } = Astro.props
const blogPath = getBlogPath(lang)
const topics = tags.slice(0, 5)
const heading = lang === 'vi' ? 'Khám phá chủ đề' : 'Explore topics'
const description =
  lang === 'vi' ? 'Những lĩnh vực mình thường viết về.' : 'The subjects I return to most often.'
const articleLabel = lang === 'vi' ? 'bài viết' : 'posts'
---

<section class="approved-topics border-border bg-background border-b">
  <div class="container py-11 sm:py-14 lg:py-16">
    <div class="mb-7 flex items-end justify-between gap-5">
      <div>
        <h2 class="editorial-display text-3xl leading-none font-semibold tracking-[-0.035em] sm:text-4xl">
          {heading}
        </h2>
        <p class="text-muted-foreground mt-2 text-sm leading-6 sm:text-base">{description}</p>
      </div>
      <a href={blogPath} class="site-footer-link hidden sm:inline-flex">
        {linkText} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {
        topics.map(({ name, count }, index) => (
          <a
            href={`${blogPath}?tag=${encodeURIComponent(name)}`}
            class="approved-topic-card group border-border hover:border-primary/45 relative min-h-[9.5rem] overflow-hidden border bg-card/55 p-4 transition-colors sm:p-5"
          >
            <div class="flex items-start justify-between gap-4">
              <span class="font-mono text-[0.58rem] tracking-[0.16em] text-muted-foreground/65 uppercase">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="h-7 w-7 rounded-full border border-border transition-transform duration-300 group-hover:translate-x-1 group-hover:border-primary/50" aria-hidden="true" />
            </div>
            <div class="mt-7">
              <h3 class="editorial-display text-foreground group-hover:text-primary text-xl leading-tight font-semibold tracking-[-0.025em] transition-colors">
                {name}
              </h3>
              <p class="text-muted-foreground mt-2 font-mono text-[0.62rem] tracking-[0.08em] uppercase">
                {count} {articleLabel}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-6 sm:hidden">
      <a href={blogPath} class="site-footer-link inline-flex">
        {linkText} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
