{
  "extends": [
    "astro/tsconfigs/strict",
    "../../tsconfig.base.json"
  ],
  "include": [
    ".astro/types.d.ts",
    "src",
    "src/pages/.well-known/**/*.ts",
    "*.config.ts",
    "*.config.js",
    "*.config.mjs",
  ],
  "exclude": [
    "dist",
    "node_modules"
  ],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  }
}