{
  "version": 1,
  "verification": {
    "entrypoint": ".harness/init.mjs",
    "commands": ["pnpm check", "pnpm typecheck", "pnpm lint", "pnpm test", "pnpm build"]
  },
  "policies": {
    "default": "deny",
    "merge": "human-or-lead-agent-only"
